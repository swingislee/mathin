NEXT_PUBLIC_SITE_URL=http://localhost:3130
# 安全默认值只允许本机 Supabase。supabase.mathin.club 是 R1-Live 正式目标；
# 开发 fixture/全库重建永久拒绝它，课程导入/apply 默认拒绝并走独立生产审批通道。
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=replace-with-your-publishable-key
# 仅服务端（Server Actions）使用，绕过 RLS 做受信写入；绝不能带 NEXT_PUBLIC_ 前缀
SUPABASE_SECRET_KEY=replace-with-your-secret-key

# 所有开发/测试写命令必须显式声明非生产目标并精确匹配实际入口。
# 当前只登记 loopback；LAN/远程开发目标必须先以代码评审登记稳定指纹，不能临时填任意 hash 放行。
MATHIN_WRITE_TARGET_ENVIRONMENT=development
MATHIN_WRITE_ALLOWED_SUPABASE_ORIGIN=http://127.0.0.1:54321
# 多个 Storage/Supabase 写入口时使用逗号分隔，并清空上一行的单值变量。
MATHIN_WRITE_ALLOWED_SUPABASE_ORIGINS=
MATHIN_WRITE_ALLOWED_DATABASE_TARGET=127.0.0.1:5432/postgres
MATHIN_WRITE_ALLOWED_SSH_TARGET=
MATHIN_WRITE_TARGET_FINGERPRINT=

# R1-2 durable worker. Production deployment runs exactly one or more named workers;
# every claim is protected by a database lease and effect idempotency key.
R1_JOB_WORKER_ID=
R1_JOB_BATCH=10
R1_JOB_LEASE_SECONDS=300
R1_JOB_POLL_MS=2000

# External providers are disabled until integration_channels selects a provider and
# references an environment variable matching MATHIN_*_SECRET. Never commit real values.
# MATHIN_WEBHOOK_EXAMPLE_SECRET=

# 可选的服务端错误看板接收端。生产环境只接受 HTTPS；token 仅服务端读取。
# 接收 JSON：event/message/digest/path/method/routeType/environment/release。
MATHIN_ERROR_REPORT_URL=
MATHIN_ERROR_REPORT_TOKEN=
MATHIN_RELEASE=

# 课堂 T1 局域网直连的 ICE 服务器（P4-6）。浏览器会把 host 候选混淆成 mDNS，
# 跨设备（手机↔电脑）常解析不了；局域网内的 coturn 通过 STUN 返回真实局域网
# 地址（srflx）绕开该问题，TURN 兜底 AP 隔离。不配则回落公网 STUN（国内不可靠）。
NEXT_PUBLIC_WEBRTC_STUN=stun:192.168.5.183:3478
NEXT_PUBLIC_WEBRTC_TURN=turn:192.168.5.183:3478?transport=udp
NEXT_PUBLIC_WEBRTC_TURN_USER=mathin
NEXT_PUBLIC_WEBRTC_TURN_PASS=replace-with-coturn-password
