<view class="portal-page theme-{{theme}} agenda-page">
  <app-nav title="{{screen.title || (participants[selected].name ? participants[selected].name + copy.participantAgenda : title)}}" back />
  <view class="portal-content"><screen-content description="{{screen.description}}" page-id="{{screen.beforePageId}}" locale="{{locale}}" revision="{{configurationRevision}}" />
    <screen-section presentation="{{screen.modules.participant}}"><participant-picker wx:if="{{participants.length > 1}}" rows="{{participants}}" selected="{{selected}}" label="{{copy.switchParticipant}}" bindchange="participant" /></screen-section>
    <screen-section presentation="{{screen.modules.calendar}}"><view class="calendar-panel"><view class="calendar-toolbar"><text class="calendar-title">{{month}}</text><view class="calendar-actions"><button class="calendar-arrow" data-offset="-1" bindtap="changeMonth" aria-label="{{copy.previousMonth}}">‹</button><button class="calendar-arrow" data-offset="1" bindtap="changeMonth" aria-label="{{copy.nextMonth}}">›</button></view></view>
      <date-grid days="{{days}}" weekdays="{{weekdays}}" today-label="{{copy.todayShort}}" bindselect="day" />
    </view></screen-section>
    <view class="card-heading agenda-heading"><text class="section-title">{{copy.dayArrangements}}</text><button class="text-link" bindtap="today">{{copy.today}}</button></view>
    <button wx:if="{{!authenticated}}" class="primary" bindtap="login">{{copy.loginCalendar}}</button>
    <text wx:elif="{{loading}}" class="loading-line">{{copy.loading}}</text>
    <empty-state wx:elif="{{loaded && !dayEvents.length && !error}}" label="{{participants.length ? copy.noDayArrangements : copy.noLinkNote}}" compact />
    <screen-section presentation="{{screen.modules.content}}"><schedule-list rows="{{dayEvents}}" labels="{{copy}}" density="{{screen.modules.content.density}}" /></screen-section>
    <view wx:if="{{error}}" class="notice" role="alert">{{error}}<button class="text-button" bindtap="retry" disabled="{{loading}}">{{copy.retry}}</button></view>
  <screen-content page-id="{{screen.afterPageId}}" locale="{{locale}}" revision="{{configurationRevision}}" /></view>
</view>
