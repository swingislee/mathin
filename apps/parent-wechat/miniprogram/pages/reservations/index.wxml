<view class="portal-page theme-{{theme}} reservation-page">
  <view class="white-header"><app-nav title="{{screen.title || (title)}}" back /><view class="reservation-toolbar"><filter-tabs options="{{statusOptions}}" value="{{filter}}" disabled="{{busy}}" bindchange="filter" /><picker range="{{participantNames}}" value="{{participantIndex}}" bindchange="participant" disabled="{{!participants.length}}"><view class="reservation-member">{{participantNames[participantIndex] || copy.allLinkedParticipants}}<text>▾</text></view></picker></view></view>
  <view class="portal-content"><screen-content description="{{screen.description}}" page-id="{{screen.beforePageId}}" locale="{{locale}}" revision="{{configurationRevision}}" />
    <view wx:if="{{!authenticated}}" class="reservation-empty"><empty-state kind="box" label="{{copy.noBookings}}" /><button class="primary" bindtap="login">{{copy.loginBookings}}</button></view>
    <text wx:elif="{{loading && !loaded}}" class="loading-line">{{copy.loading}}</text>
    <view wx:elif="{{loaded && !bookings.length && !error}}" class="reservation-empty"><empty-state kind="box" label="{{copy.noBookings}}" /><button class="text-link empty-action" bindtap="discover">{{copy.browseActivities}}<view class="chevron"></view></button></view>
    <screen-section presentation="{{screen.modules.content}}"><record-card wx:for="{{bookings}}" wx:key="key" heading="{{item.label}}" status="{{item.statusText}}" participant="{{item.participantName}}" subtitle="{{item.when}}" density="{{screen.modules.content.density}}"><text wx:if="{{item.details}}" class="muted small block">{{item.details}}</text><text class="muted small block">{{item.location || copy.locationPending}}</text><button wx:if="{{item.kind === 'assessment'}}" class="text-link" data-key="{{item.key}}" bindtap="openAssessment">{{copy.view}}</button><button wx:if="{{item.cancellable}}" class="outline-pill cancel-action" data-id="{{item.id}}" bindtap="cancel" disabled="{{busy}}">{{copy.cancelBooking}}</button></record-card></screen-section>
    <view wx:if="{{error}}" class="notice" role="alert">{{error}}<button wx:if="{{authenticated}}" class="text-button" bindtap="load" disabled="{{busy}}">{{copy.retry}}</button></view>
  <screen-content page-id="{{screen.afterPageId}}" locale="{{locale}}" revision="{{configurationRevision}}" /></view>
</view>
