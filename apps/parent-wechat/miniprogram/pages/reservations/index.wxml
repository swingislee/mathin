<view class="page">
  <text class="brand">{{brandName}}</text><text class="title">{{title}}</text><text class="description muted">{{description}}</text>
  <view wx:if="{{!authenticated}}" class="signin-panel"><text class="row-title">{{copy.loginRequired}}</text><text class="muted prose">{{copy.reservationLoginNote}}</text><button class="primary" bindtap="login">{{copy.login}}</button><text class="subheading">{{copy.newVisitor}}</text><text class="small muted block">{{copy.newVisitorNote}}</text><button class="text-button" bindtap="register">{{copy.intakeAction}} →</button></view>
  <block wx:else>
    <picker wx:if="{{participants.length > 1}}" class="member-filter" range="{{participantNames}}" value="{{participantIndex}}" bindchange="participant"><view class="filter-control">{{participantNames[participantIndex]}} <text>⌄</text></view></picker>
    <view class="segment-control"><button class="segment {{filter === 'upcoming' ? 'active' : ''}}" data-value="upcoming" bindtap="filter">{{copy.upcoming}} <text class="small">{{upcomingCount}}</text></button><button class="segment {{filter === 'history' ? 'active' : ''}}" data-value="history" bindtap="filter">{{copy.history}} <text class="small">{{historyCount}}</text></button></view>
    <text wx:if="{{loading && !loaded}}" class="empty">{{copy.loading}}</text>
    <view wx:elif="{{loaded && !bookings.length}}" class="empty-state"><text class="empty-symbol" aria-hidden="true">◷</text><text class="row-title">{{filter === 'upcoming' ? copy.noUpcoming : copy.noHistory}}</text><text wx:if="{{!participants.length}}" class="muted small block">{{copy.noLinkNote}}</text><button class="secondary" bindtap="discover">{{copy.browseActivities}}</button></view>
    <view wx:for="{{bookings}}" wx:key="id" class="reservation-card"><view class="row"><text class="tag {{item.status === 'booked' ? 'success' : ''}}">{{item.statusText}}</text><text class="small muted">{{item.participantName}}</text></view><text class="row-title">{{item.label}}</text><text class="block">{{item.when}}</text><text class="muted small block">{{item.location || copy.locationPending}}</text><button wx:if="{{item.cancellable}}" class="text-button cancel-action" data-id="{{item.id}}" bindtap="cancel" disabled="{{busy}}">{{copy.cancelBooking}}</button><text wx:elif="{{item.status === 'booked'}}" class="small muted block">{{copy.cancelUnavailable}}</text></view>
  </block>
  <view wx:if="{{error}}" class="notice" role="alert">{{error}}<button wx:if="{{authenticated}}" class="text-button" bindtap="load" disabled="{{busy}}">{{copy.retry}}</button></view>
</view>
