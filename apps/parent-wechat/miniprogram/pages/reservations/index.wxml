<view class="portal-page reservation-page">
  <view class="white-header"><app-nav title="{{title}}" back /><view class="reservation-toolbar"><view class="status-tabs"><button class="{{filter === 'upcoming' ? 'active' : ''}}" data-value="upcoming" bindtap="filter">{{copy.upcoming}}</button><button class="{{filter === 'attended' ? 'active' : ''}}" data-value="attended" bindtap="filter">{{copy.attended}}</button><button class="{{filter === 'cancelled' ? 'active' : ''}}" data-value="cancelled" bindtap="filter">{{copy.cancelled}}</button><button class="{{filter === 'all' ? 'active' : ''}}" data-value="all" bindtap="filter">{{copy.all}}</button></view><picker range="{{participantNames}}" value="{{participantIndex}}" bindchange="participant" disabled="{{!participants.length}}"><view class="reservation-member">{{participantNames[participantIndex] || copy.allLinkedParticipants}}<text>▾</text></view></picker></view></view>
  <view class="portal-content">
    <view wx:if="{{!authenticated}}" class="reservation-empty"><empty-state kind="box" label="{{copy.noBookings}}" /><button class="primary" bindtap="login">{{copy.loginBookings}}</button></view>
    <text wx:elif="{{loading && !loaded}}" class="loading-line">{{copy.loading}}</text>
    <view wx:elif="{{loaded && !bookings.length && !error}}" class="reservation-empty"><empty-state kind="box" label="{{copy.noBookings}}" /><button class="text-link empty-action" bindtap="discover">{{copy.browseActivities}}<view class="chevron"></view></button></view>
    <view wx:for="{{bookings}}" wx:key="key" class="surface reservation-card"><view class="row"><text class="booking-person">{{item.participantName}}</text><text class="booking-status">{{item.statusText}}</text></view><text class="row-title">{{item.label}}</text><text wx:if="{{item.details}}" class="muted small block">{{item.details}}</text><text class="block muted">{{item.when}}</text><text class="muted small block">{{item.location || copy.locationPending}}</text><button wx:if="{{item.kind === 'assessment'}}" class="text-link" data-key="{{item.key}}" bindtap="openAssessment">{{copy.view}}<view class="chevron"></view></button><button wx:if="{{item.cancellable}}" class="outline-pill cancel-action" data-id="{{item.id}}" bindtap="cancel" disabled="{{busy}}">{{copy.cancelBooking}}</button></view>
    <view wx:if="{{error}}" class="notice" role="alert">{{error}}<button wx:if="{{authenticated}}" class="text-button" bindtap="load" disabled="{{busy}}">{{copy.retry}}</button></view>
  </view>
</view>
