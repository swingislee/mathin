.catalog-heading{display:flex;justify-content:space-between;align-items:center;margin-bottom:24rpx}.categories{white-space:nowrap;margin-bottom:24rpx}.categories button{display:inline-block;margin-right:12rpx}.selected{font-weight:600}.service-card{display:flex;gap:20rpx;align-items:center;text-align:left;padding:28rpx;border:0;margin-bottom:24rpx;font-size:28rpx;line-height:1.6;white-space:normal}.service-card::after{border:0}.service-card>view{flex:1}.service-card image{width:140rpx;height:140rpx;border-radius:16rpx;flex-shrink:0}.summary{display:block;font-size:26rpx;line-height:1.7;margin:10rpx 0}
