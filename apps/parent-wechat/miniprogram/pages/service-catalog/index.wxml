<view class="portal-page theme-{{theme}}"><app-nav title="{{screen.title || (locale === 'en' ? 'Services' : '服务目录')}}" back /><view class="portal-content"><screen-content description="{{screen.description}}" page-id="{{screen.beforePageId}}" locale="{{locale}}" revision="{{configurationRevision}}" /><block wx:for="{{screen.moduleOrder}}" wx:for-item="moduleId" wx:key="*this">
<screen-section wx:if="{{moduleId === 'shortcuts'}}" presentation="{{screen.modules.shortcuts}}"><view class="catalog-heading"><text class="section-title">{{locale === 'en' ? 'Find a service' : '选择适合的服务'}}</text><button class="text-button" bindtap="requests">{{locale === 'en' ? 'My requests' : '我的服务申请'}}</button><button class="text-button" bindtap="bookings">{{locale === 'en' ? 'My bookings' : '我的服务预约'}}</button><button class="text-button" bindtap="notifications">{{locale === 'en' ? 'Notifications' : '服务消息'}}</button></view></screen-section>
<screen-section wx:if="{{moduleId === 'filters'}}" presentation="{{screen.modules.filters}}"><filter-tabs wx:if="{{categories.length > 1}}" options="{{categories}}" value="{{category}}" bindchange="category" /></screen-section>
<screen-section wx:if="{{moduleId === 'content'}}" presentation="{{screen.modules.content}}"><content-cards rows="{{services}}" density="{{screen.modules.content.density}}" bindselect="open" /></screen-section>
</block><empty-state wx:if="{{!services.length}}" label="{{locale === 'en' ? 'No services in this category yet' : '此分类暂无服务'}}" spacious /><screen-content page-id="{{screen.afterPageId}}" locale="{{locale}}" revision="{{configurationRevision}}" /></view></view>
