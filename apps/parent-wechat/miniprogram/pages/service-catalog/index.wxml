<view class="portal-page theme-{{theme}}"><app-nav title="{{locale === 'en' ? 'Services' : '服务目录'}}" back /><view class="portal-content"><view class="catalog-heading"><text class="section-title">{{locale === 'en' ? 'Find a service' : '选择适合的服务'}}</text><button class="text-button" bindtap="requests">{{locale === 'en' ? 'My requests' : '我的服务申请'}}</button><button class="text-button" bindtap="bookings">{{locale === 'en' ? 'My bookings' : '我的服务预约'}}</button><button class="text-button" bindtap="notifications">{{locale === 'en' ? 'Notifications' : '服务消息'}}</button></view><scroll-view wx:if="{{categories.length}}" scroll-x class="categories"><button class="filter-pill {{!category ? 'selected' : ''}}" bindtap="category" data-id="">{{locale === 'en' ? 'All' : '全部'}}</button><button wx:for="{{categories}}" wx:key="id" class="filter-pill {{category === item.id ? 'selected' : ''}}" data-id="{{item.id}}" bindtap="category">{{item.label}}</button></scroll-view><button wx:for="{{services}}" wx:key="id" class="service-card surface" data-id="{{item.id}}" bindtap="open"><image wx:if="{{item.image}}" src="{{item.image}}" mode="aspectFill" lazy-load /><view><text class="section-title">{{item.name}}</text><text class="summary">{{item.summary}}</text><text class="small muted">{{item.price}}</text></view><text>›</text></button><empty-state wx:if="{{!services.length}}" label="{{locale === 'en' ? 'No services in this category yet' : '此分类暂无服务'}}" spacious /></view></view>
