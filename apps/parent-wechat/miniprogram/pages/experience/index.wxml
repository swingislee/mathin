<view class="portal-page theme-{{theme}}"><app-nav title="{{title || brandName}}" back /><view class="portal-content"><text wx:if="{{loading}}" class="loading-line">{{copy.loading}}</text><view wx:if="{{error}}" class="notice">{{error}}<button class="text-button" bindtap="load">{{copy.retry}}</button></view><content-document wx:if="{{document}}" document="{{document}}" images="{{images}}" locale="{{locale}}" /></view></view>
