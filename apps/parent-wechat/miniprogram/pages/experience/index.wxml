<view class="portal-page theme-{{theme}}"><app-nav title="{{screen.title || (title || brandName)}}" back /><view class="portal-content"><screen-content description="{{screen.description}}" page-id="{{screen.beforePageId}}" locale="{{locale}}" revision="{{configurationRevision}}" /><text wx:if="{{loading}}" class="loading-line">{{copy.loading}}</text><view wx:if="{{error}}" class="notice">{{error}}<button class="text-button" bindtap="load">{{copy.retry}}</button></view><screen-section presentation="{{screen.modules.content}}"><content-document wx:if="{{document}}" document="{{document}}" images="{{images}}" locale="{{locale}}" /></screen-section><screen-content page-id="{{screen.afterPageId}}" locale="{{locale}}" revision="{{configurationRevision}}" /></view></view>
