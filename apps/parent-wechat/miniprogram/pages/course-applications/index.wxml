<view class="portal-page"><app-nav title="{{t.applications}}" back /><view class="portal-content">
  <view class="application-filters"><button wx:for="{{statuses}}" wx:key="id" class="{{filter === item.id ? 'selected' : ''}}" data-id="{{item.id}}" bindtap="filter">{{item.label}}</button></view>
  <view wx:if="{{error}}" class="notice">{{error}}<button class="text-button" disabled="{{busy}}" bindtap="load">{{copy.retry}}</button></view>
  <button wx:if="{{!authenticated}}" class="primary" bindtap="login">{{copy.signInNow}}</button><text wx:elif="{{loading}}" class="loading-line">{{copy.loading}}</text>
  <empty-state wx:elif="{{!rows.length && !error}}" label="{{t.historyEmpty}}" spacious />
  <view wx:for="{{rows}}" wx:key="id" class="surface course-summary"><view class="card-heading"><text class="section-title">{{item.title}}</text><text class="small muted">{{item.statusLabel}}</text></view><text class="block">{{item.participantName}} · {{item.className}}</text><text class="small muted block">{{item.dateLabel}} · {{t.fee}} {{item.price}}</text><text wx:if="{{item.reply}}" class="course-description block">{{item.reply}}</text><button wx:if="{{item.status === 'pending'}}" class="text-button" disabled="{{busy}}" data-id="{{item.id}}" bindtap="cancel">{{t.cancel}}</button></view>
</view></view>
