<view class="portal-page theme-{{theme}}">
  <app-nav title="{{formTitle || copy.registrationTitle}}" back />
  <view wx:if="{{hub}}" class="portal-content registration-history">
    <view wx:if="{{saved}}" class="notice">{{copy.registrationReceipt}}</view>
    <button class="primary" bindtap="fillRegistration" disabled="{{loading}}">{{copy.registrationFill}}</button>
    <text class="registration-heading">{{copy.registrationHistory}}</text>
    <view wx:if="{{!loggedIn}}" class="empty-state"><text>{{copy.loginRequired}}</text><button class="text-button" bindtap="login">{{copy.signInNow}}</button></view>
    <block wx:else>
      <view wx:for="{{records}}" wx:key="id" class="registration-record">
        <button class="registration-summary" data-index="{{index}}" bindtap="toggleRecord">
          <view><text class="row-title block">{{item.title}}</text><text class="muted small">{{item.submittedAt}}</text></view>
          <text class="small">{{item.expanded ? copy.collapse : copy.details}}</text>
        </button>
        <view wx:if="{{item.expanded}}" class="registration-details">
          <view wx:for="{{item.sections}}" wx:for-item="section" wx:key="index" class="registration-section">
            <text class="subheading block">{{section.title}}</text>
            <view wx:for="{{section.fields}}" wx:for-item="field" wx:key="index" class="registration-field"><text class="muted">{{field.label}}</text><text>{{field.value}}</text></view>
          </view>
        </view>
      </view>
      <text wx:if="{{loading}}" class="loading-line">{{copy.loading}}</text>
      <view wx:elif="{{error}}" class="notice" role="alert">{{error}}<button class="text-button" bindtap="loadHistory">{{copy.retry}}</button></view>
      <view wx:elif="{{!records.length}}" class="empty-state">{{copy.registrationEmpty}}</view>
      <button wx:if="{{hasMore && !loading}}" class="text-button" bindtap="moreHistory">{{copy.registrationMore}}</button>
    </block>
  </view>
  <view wx:else class="portal-content has-fixed-actions">
    <view wx:if="{{submitted}}" class="surface booking-success"><text class="success-symbol">✓</text><text class="row-title">{{copy.registrationReceipt}}</text><button class="primary" bindtap="explore">{{copy.seeActivities}}</button></view>
    <block wx:else>
      <text wx:if="{{loading}}" class="loading-line">{{copy.loading}}</text>
      <block wx:elif="{{form}}">
        <text wx:if="{{formDescription}}" class="form-help block">{{formDescription}}</text>
        <view class="surface form-card"><view wx:for="{{fields}}" wx:key="id" class="field">
          <view class="field-label"><text>{{item.label}}</text><text class="muted small">{{item.required ? copy.required : copy.optional}}</text></view>
          <input wx:if="{{item.type === 'text' || item.type === 'phone'}}" class="input" type="text" value="{{item.value}}" data-index="{{index}}" bindinput="input" maxlength="{{item.type === 'phone' ? 30 : 200}}" placeholder="{{item.label}}" disabled="{{busy}}" />
          <textarea wx:elif="{{item.type === 'textarea'}}" class="input textarea" value="{{item.value}}" data-index="{{index}}" bindinput="input" maxlength="2000" placeholder="{{item.label}}" disabled="{{busy}}" />
          <button wx:elif="{{item.type === 'select'}}" class="input row" data-index="{{index}}" bindtap="showOptions" disabled="{{busy}}"><text>{{item.value || copy.select}}</text><view class="chevron down"></view></button>
          <checkbox-group wx:elif="{{item.type === 'multiselect'}}" data-index="{{index}}" bindchange="check"><label wx:for="{{item.options}}" wx:for-item="option" wx:key="id" class="check-option"><checkbox value="{{option.id}}" checked="{{option.checked}}" disabled="{{busy}}" />{{option.label}}</label></checkbox-group>
        </view></view>
        <view class="form-privacy"><text class="subheading">{{copy.privacy}}</text><text class="muted prose">{{privacy}}</text><checkbox-group bindchange="consent"><label class="check-option"><checkbox value="agree" checked="{{consent}}" disabled="{{busy}}" /><text>{{copy.consent}}</text></label></checkbox-group></view>
      </block>
      <view wx:if="{{error}}" class="notice" role="alert">{{error}}<button wx:if="{{!form}}" class="text-button" bindtap="load" disabled="{{busy}}">{{copy.retry}}</button></view>
    </block>
  </view>
  <view wx:if="{{form && !submitted}}" class="fixed-actions"><button class="primary" bindtap="submit" loading="{{busy}}" disabled="{{busy}}">{{busy ? copy.submitting : copy.submit}}</button></view>
  <view wx:if="{{optionField >= 0}}" class="sheet-mask" bindtap="closeOptions" catchtouchmove="noop"><view class="bottom-sheet" catchtap="noop"><view class="sheet-heading"><text>{{fields[optionField].label}}</text><button class="sheet-close" bindtap="closeOptions" aria-label="{{copy.close}}">×</button></view><scroll-view scroll-y class="sheet-scroll"><view class="option-grid"><button wx:for="{{fields[optionField].options}}" wx:key="id" class="option-pill {{fields[optionField].index === index && fields[optionField].value ? 'selected' : ''}}" data-value="{{index}}" bindtap="chooseOption">{{item.label}}</button></view></scroll-view></view></view>
</view>
