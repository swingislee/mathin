<view class="portal-page theme-{{theme}}"><app-nav title="{{screen.title || (locale === 'en' ? 'Service notifications' : '服务消息')}}" back /><view class="portal-content"><screen-content description="{{screen.description}}" page-id="{{screen.beforePageId}}" locale="{{locale}}" revision="{{configurationRevision}}" /><button wx:if="{{!authenticated}}" class="primary-button" bindtap="login">{{copy.login}}</button><text wx:if="{{loading}}" class="loading-line">{{copy.loading}}</text><view wx:if="{{error}}" class="notice">{{error}}<button class="text-button" bindtap="load">{{copy.retry}}</button></view><screen-section presentation="{{screen.modules.content}}"><record-card wx:for="{{notices}}" wx:key="id" heading="{{item.title}}" subtitle="{{item.when}}" note="{{item.body}}" density="{{screen.modules.content.density}}" /></screen-section><empty-state wx:if="{{authenticated && !loading && !notices.length && !error}}" label="{{locale === 'en' ? 'No notifications yet' : '暂无服务消息'}}" spacious /><screen-content page-id="{{screen.afterPageId}}" locale="{{locale}}" revision="{{configurationRevision}}" /></view></view>
