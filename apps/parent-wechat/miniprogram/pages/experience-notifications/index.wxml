<view class="portal-page theme-{{theme}}"><app-nav title="{{locale === 'en' ? 'Service notifications' : '服务消息'}}" back /><view class="portal-content"><button wx:if="{{!authenticated}}" class="primary-button" bindtap="login">{{copy.login}}</button><text wx:if="{{loading}}" class="loading-line">{{copy.loading}}</text><view wx:if="{{error}}" class="notice">{{error}}<button class="text-button" bindtap="load">{{copy.retry}}</button></view><view wx:for="{{notices}}" wx:key="id" class="notification surface"><text class="section-title">{{item.title}}</text><text class="notification-body">{{item.body}}</text><text class="small muted">{{item.when}}</text></view><empty-state wx:if="{{authenticated && !loading && !notices.length && !error}}" label="{{locale === 'en' ? 'No notifications yet' : '暂无服务消息'}}" spacious /></view></view>
