<view class="portal-page theme-{{theme}}"><app-nav title="{{locale === 'en' ? 'My service requests' : '我的服务申请'}}" back /><view class="portal-content"><button wx:if="{{!authenticated}}" class="primary-button" bindtap="login">{{copy.login}}</button><text wx:if="{{loading}}" class="loading-line">{{copy.loading}}</text><view wx:if="{{error}}" class="notice">{{error}}<button class="text-button" bindtap="load">{{copy.retry}}</button></view><view wx:for="{{rows}}" wx:key="id" class="request surface"><button class="request-heading" data-id="{{item.id}}" bindtap="toggle"><text class="section-title">{{item.title}}</text><text class="small muted">{{item.when}} · {{item.statusLabel}}</text></button><block wx:if="{{expanded === item.id}}"><view wx:for="{{item.fields}}" wx:for-item="field" wx:key="key" class="answer"><text class="small muted">{{field.label}}</text><text>{{field.value}}</text></view><text wx:if="{{item.note}}" class="reply">{{item.note}}</text><button wx:if="{{item.canCancel}}" class="text-button" disabled="{{busy}}" data-id="{{item.id}}" bindtap="cancel">{{locale === 'en' ? 'Cancel request' : '取消申请'}}</button></block></view><empty-state wx:if="{{authenticated && !loading && !rows.length && !error}}" label="{{locale === 'en' ? 'No requests yet' : '暂无服务申请'}}" spacious /><view wx:if="{{authenticated}}" class="paging"><button wx:if="{{page > 1}}" class="text-button" disabled="{{loading}}" bindtap="previous">{{locale === 'en' ? 'Previous' : '上一页'}}</button><button wx:if="{{more}}" class="text-button" disabled="{{loading}}" bindtap="next">{{locale === 'en' ? 'Next' : '下一页'}}</button></view></view></view>
