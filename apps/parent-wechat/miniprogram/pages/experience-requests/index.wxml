<view class="portal-page theme-{{theme}}"><app-nav title="{{screen.title || (locale === 'en' ? 'My service requests' : '我的服务申请')}}" back /><view class="portal-content"><screen-content description="{{screen.description}}" page-id="{{screen.beforePageId}}" locale="{{locale}}" revision="{{configurationRevision}}" /><button wx:if="{{!authenticated}}" class="primary-button" bindtap="login">{{copy.login}}</button><text wx:if="{{loading}}" class="loading-line">{{copy.loading}}</text><view wx:if="{{error}}" class="notice">{{error}}<button class="text-button" bindtap="load">{{copy.retry}}</button></view><screen-section presentation="{{screen.modules.content}}"><record-card wx:for="{{rows}}" wx:key="id" heading="{{item.title}}" status="{{item.statusLabel}}" subtitle="{{item.when}}" interactive expanded="{{expanded === item.id}}" data-id="{{item.id}}" bindselect="toggle" density="{{screen.modules.content.density}}"><block wx:if="{{expanded === item.id}}"><answer-list rows="{{item.fields}}" /><text wx:if="{{item.note}}" class="reply">{{item.note}}</text><button wx:if="{{item.canCancel}}" class="text-button" disabled="{{busy}}" data-id="{{item.id}}" bindtap="cancel">{{locale === 'en' ? 'Cancel request' : '取消申请'}}</button></block></record-card></screen-section><empty-state wx:if="{{authenticated && !loading && !rows.length && !error}}" label="{{locale === 'en' ? 'No requests yet' : '暂无服务申请'}}" spacious /><view wx:if="{{authenticated}}" class="paging"><button wx:if="{{page > 1}}" class="text-button" disabled="{{loading}}" bindtap="previous">{{locale === 'en' ? 'Previous' : '上一页'}}</button><button wx:if="{{more}}" class="text-button" disabled="{{loading}}" bindtap="next">{{locale === 'en' ? 'Next' : '下一页'}}</button></view><screen-content page-id="{{screen.afterPageId}}" locale="{{locale}}" revision="{{configurationRevision}}" /></view></view>
