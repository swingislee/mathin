<view class="portal-page theme-{{theme}}"><app-nav title="{{title || brandName}}" back /><view class="portal-content"><text wx:if="{{loading}}" class="loading-line">{{copy.loading}}</text><view wx:if="{{error}}" class="notice">{{error}}<button class="text-button" bindtap="load">{{copy.retry}}</button></view><block wx:if="{{detail}}"><view class="service-summary surface"><text class="service-title">{{title}}</text><text class="service-description">{{summary}}</text><text class="small muted">{{price}}{{detail.document.durationMinutes ? ' · ' + detail.document.durationMinutes + (locale === 'en' ? ' min' : ' 分钟') : ''}}</text></view><content-document wx:if="{{detail.content}}" document="{{detail.content}}" images="{{detail.images}}" locale="{{locale}}" /><view wx:if="{{resourceRows.length}}" class="surface resource-list"><view wx:for="{{resourceRows}}" wx:key="id"><text class="section-title">{{item.name}}</text><text class="small muted">{{item.detail}}</text></view></view><content-document wx:if="{{detail.preparation}}" document="{{detail.preparation}}" images="{{detail.images}}" locale="{{locale}}" /><button wx:if="{{detail.ready}}" class="primary-button" bindtap="book">{{locale === 'en' ? 'Continue' : '继续预约'}}</button><text wx:else class="notice">{{message}}</text></block></view></view>
