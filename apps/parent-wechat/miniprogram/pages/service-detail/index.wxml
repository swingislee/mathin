<view class="portal-page theme-{{theme}}"><app-nav title="{{screen.title || (title || brandName)}}" back /><view class="portal-content"><screen-content description="{{screen.description}}" page-id="{{screen.beforePageId}}" locale="{{locale}}" revision="{{configurationRevision}}" /><text wx:if="{{loading}}" class="loading-line">{{copy.loading}}</text><view wx:if="{{error}}" class="notice">{{error}}<button class="text-button" bindtap="load">{{copy.retry}}</button></view><block wx:if="{{detail}}"><block wx:for="{{screen.moduleOrder}}" wx:for-item="moduleId" wx:key="*this">
<screen-section wx:if="{{moduleId === 'summary'}}" presentation="{{screen.modules.summary}}"><view class="service-summary surface"><text class="service-title">{{title}}</text><text class="service-description">{{summary}}</text><text class="small muted">{{price}}{{detail.document.durationMinutes ? ' · ' + detail.document.durationMinutes + (locale === 'en' ? ' min' : ' 分钟') : ''}}</text></view></screen-section>
<screen-section wx:if="{{moduleId === 'content'}}" presentation="{{screen.modules.content}}"><content-document wx:if="{{detail.content}}" document="{{detail.content}}" context="{{contentContext}}" images="{{detail.images}}" locale="{{locale}}" /></screen-section>
<screen-section wx:if="{{moduleId === 'resources'}}" presentation="{{screen.modules.resources}}"><view wx:if="{{resourceRows.length}}" class="surface resource-list density-{{screen.modules.resources.density}}"><view wx:for="{{resourceRows}}" wx:key="id"><text class="section-title">{{item.name}}</text><text class="small muted">{{item.detail}}</text></view></view></screen-section>
<screen-section wx:if="{{moduleId === 'preparation'}}" presentation="{{screen.modules.preparation}}"><content-document wx:if="{{detail.preparation}}" document="{{detail.preparation}}" images="{{detail.images}}" locale="{{locale}}" /></screen-section>
</block><button wx:if="{{detail.ready}}" class="primary-button" bindtap="book">{{locale === 'en' ? 'Continue' : '继续预约'}}</button><text wx:else class="notice">{{message}}</text></block><screen-content page-id="{{screen.afterPageId}}" locale="{{locale}}" revision="{{configurationRevision}}" /></view></view>
