.slot-picker{margin:24rpx 0}.date-picker{padding:24rpx;background:var(--card,#f4f5ef);border-radius:16rpx;font-size:32rpx}.slot{font-size:28rpx;margin:16rpx 0;padding:14rpx;border-radius:14rpx;background:var(--card,#f4f5ef);white-space:normal}.slot.selected{background:var(--primary,#587564);color:white}.participant{display:flex;align-items:center;gap:14rpx;padding:16rpx 0;font-size:28rpx}.consent-body{height:260rpx;font-size:25rpx;line-height:1.8;white-space:pre-wrap;margin:20rpx 0}.primary-button{margin:32rpx 0}.result{padding:32rpx}.result text{display:block;line-height:1.8}
