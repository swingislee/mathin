<view class="portal-page theme-{{theme}}"><app-nav title="{{screen.title || (title || (locale === 'en' ? 'Booking' : '服务预约'))}}" back /><view class="portal-content"><screen-content description="{{screen.description}}" page-id="{{screen.beforePageId}}" locale="{{locale}}" revision="{{configurationRevision}}" /><button wx:if="{{!authenticated}}" class="primary" bindtap="login">{{copy.login}}</button><text wx:if="{{loading}}" class="loading-line">{{copy.loading}}</text><view wx:if="{{error}}" class="notice">{{error}}</view><screen-section presentation="{{screen.modules.booking}}"><block wx:if="{{sent}}"><view class="surface result"><text class="section-title">{{locale === 'en' ? 'Request received' : '请求已收到'}}</text><text>{{sent.note}}</text></view><content-document wx:if="{{sent.confirmation}}" document="{{sent.confirmation}}" images="{{sent.images}}" locale="{{locale}}" /><button wx:if="{{sent.completionAction && sent.completionAction.kind !== 'none'}}" class="primary" bindtap="complete">{{sent.completionAction.label[locale] || sent.completionAction.label.zh}}</button><button class="primary" bindtap="bookings">{{locale === 'en' ? 'View my bookings' : '查看我的预约'}}</button></block><block wx:elif="{{detail || historical}}"><view wx:if="{{requiresSlot && !pending}}" class="slot-picker"><picker mode="date" value="{{chosenDate}}" bindchange="day" disabled="{{busy}}"><view class="date-picker">{{chosenDate}} ▾</view></picker><text class="small muted">{{locale === 'en' ? 'Times are shown in your device time zone.' : '时间按当前设备所在时区显示。'}}</text><text wx:if="{{slotsLoading}}" class="loading-line">{{copy.loading}}</text><slot-picker rows="{{slots}}" disabled="{{busy || !!pending}}" bindselect="slot" /><empty-state wx:if="{{!slotsLoading && !slots.length}}" label="{{locale === 'en' ? 'No available times. Choose another date.' : '暂无可约时间，可选择其他日期。'}}" /></view><block wx:if="{{detail && !pending}}"><view wx:if="{{detail.flow.requireParticipant || detail.flow.allowMultipleParticipants}}"><text class="section-title">{{locale === 'en' ? 'Participants' : '参与人'}}</text><participant-picker rows="{{participants}}" selected-ids="{{selectedIds}}" multiple disabled="{{busy || !!pending}}" bindchange="participants" /></view><experience-form wx:if="{{detail.form}}" form="{{detail.form}}" answers="{{answers}}" errors="{{errors}}" locale="{{locale}}" disabled="{{busy}}" bindchange="answers" /><view wx:for="{{consentDocuments}}" wx:key="id" class="consent"><text class="section-title">{{item.title}}</text><scroll-view scroll-y class="consent-body"><text>{{item.body}}</text></scroll-view><checkbox-group data-id="{{item.id}}" bindchange="consent"><label class="participant"><checkbox value="yes" checked="{{item.checked}}" disabled="{{busy}}" /><text>{{locale === 'en' ? 'I have read and agree' : '我已阅读并同意'}}</text></label></checkbox-group></view></block></block></screen-section><button wx:if="{{!sent && (detail || historical || pending)}}" class="primary" disabled="{{loading || busy || slotsLoading}}" loading="{{busy}}" bindtap="submit">{{pending ? (locale === 'en' ? 'Confirm previous request' : '确认上次提交') : (locale === 'en' ? 'Submit request' : '提交预约请求')}}</button><button wx:if="{{authenticated && !sent}}" class="text-button" bindtap="bookings">{{locale === 'en' ? 'My bookings' : '我的预约'}}</button><screen-content page-id="{{screen.afterPageId}}" locale="{{locale}}" revision="{{configurationRevision}}" /></view></view>
