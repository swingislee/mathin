.assessment-page .location-options { margin-top: 52rpx; margin-bottom: 40rpx; }
.assessment-page .teacher-options { margin: 32rpx 0 40rpx; }
.assessment-page .location-options .option-pill { min-height: 64rpx; }
.assessment-page button.option-pill[disabled] { background: var(--quiet); border-color: var(--line); color: var(--muted); opacity: .65; }
.assessment-page .slot-heading { gap: 16rpx; margin-top: 28rpx; margin-bottom: 28rpx; }
.assessment-weeks { display: flex; gap: 10rpx; }
.assessment-weeks .week-pill { padding: 10rpx 18rpx; border-radius: 40rpx; color: var(--primary); background: var(--primary-soft); font-size: 23rpx; font-weight: 600; }
.assessment-weeks .week-pill.selected { background: var(--primary); color: #fff; }
.assessment-page .slot-table { border-color: var(--primary-pale); }
.slot-week-label { text-align: center; background: var(--primary-soft); font-size: 25rpx; font-weight: 600; padding: 9rpx 0; }
.slot-date-heading, .slot-period { display: flex; align-items: center; justify-content: center; background: var(--primary-soft); font-size: 21rpx; }
.slot-date-heading { flex: 0 0 134rpx; background: var(--primary-pale); }
.slot-period { flex: 0 0 56rpx; }
.assessment-page .slot-time-heading { flex: 0 0 78rpx; box-sizing: border-box; border-left: 2rpx solid var(--primary-pale); min-height: 70rpx; font-size: 21rpx; }
.assessment-page .slot-table-header .slot-table-cell { padding: 0; }
.slot-day, .slot-weekday { padding: 6rpx 0; line-height: 1.5; }
.slot-weekday { border-top: 2rpx solid var(--primary-soft); }
.assessment-page .slot-option { min-height: 70rpx; padding: 0; font-size: 23rpx; }
.selection-hint { margin: 28rpx 0; font-size: 25rpx; line-height: 1.6; }
.assessment-sheet { padding-top: 34rpx; }
.assessment-sheet .sheet-heading { margin-bottom: 36rpx; }
.assessment-sheet .grade-scroll { height: 460rpx; }
.subject-sheet .sheet-heading { margin-bottom: 8rpx; }
.subject-sheet .option-grid { margin: 34rpx 0 44rpx; }
.subject-sheet .primary { margin: 0; }
.multi-select-note { color: var(--rose); font-size: 27rpx; margin-left: 8rpx; }
