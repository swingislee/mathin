<view class="portal-page account-page theme-{{theme}}">
  <app-nav title="{{screen.title}}" />
  <view class="portal-content"><screen-content description="{{screen.description}}" page-id="{{screen.beforePageId}}" locale="{{locale}}" revision="{{configurationRevision}}" />
    <screen-section presentation="{{screen.modules.identity}}"><view class="account-header"><button class="account-identity" bindtap="showAccount"><image class="account-avatar" src="/assets/account.png" aria-hidden="true" /><text wx:if="{{!authenticated || account}}" class="account-name">{{authenticated ? (accountName || copy.accountLabel) : copy.signInNow}}</text><view wx:else class="identity-placeholder" aria-label="{{copy.loading}}" /><view class="chevron"></view></button><button class="account-header-action" data-url="/pages/reservations/index" bindtap="open">{{copy.myBookings}}</button></view></screen-section>


    <block wx:for="{{screen.moduleOrder}}" wx:for-item="moduleId" wx:key="*this">
<screen-section wx:if="{{moduleId === 'participants'}}" presentation="{{screen.modules.participants}}"><view class="account-feature-row">
      <button class="intake-tile surface" data-url="/pages/register/index?source=account" bindtap="open"><text class="intake-tile-title">{{copy.registrationTitle}}</text><text class="small-pill">{{copy.registrationAction}}</text><image class="intake-watermark" src="/assets/icons/form.png" aria-hidden="true" /></button>
      <view class="participants-tile surface"><view class="participants-heading"><text>{{copy.linkedParticipants}}</text><button class="text-link" bindtap="showParticipants">{{copy.view}}<view class="chevron"></view></button></view><view wx:if="{{account.participants.length}}" class="participants-row"><button wx:for="{{account.participants}}" wx:key="id" wx:if="{{index < 2}}" class="participant-entry" data-id="{{item.id}}" bindtap="participant"><image class="participant-avatar" src="/assets/participant.png" aria-hidden="true" /><text>{{item.name}}</text></button></view><button wx:else class="participants-empty" bindtap="showParticipants"><image class="participant-avatar" src="/assets/participant.png" aria-hidden="true" /><view wx:if="{{authenticated && !account}}" class="identity-placeholder" aria-label="{{copy.loading}}" /><text wx:else>{{authenticated ? copy.noLinkedParticipants : copy.signInNow}}</text></button></view>
    </view></screen-section>
<screen-section wx:if="{{moduleId === 'shortcuts'}}" presentation="{{screen.modules.shortcuts}}"><view class="surface booking-shortcuts">
      <button data-url="/pages/reservations/index?filter=upcoming" bindtap="open"><image class="line-icon" src="/assets/icons/reservations.png" aria-hidden="true" /><text>{{copy.upcoming}}</text></button>
      <button data-url="/pages/reservations/index?filter=attended" bindtap="open"><image class="line-icon" src="/assets/icons/complete.png" aria-hidden="true" /><text>{{copy.attended}}</text></button>
      <button data-url="/pages/reservations/index?filter=cancelled" bindtap="open"><image class="line-icon" src="/assets/icons/cancel.png" aria-hidden="true" /><text>{{copy.cancelled}}</text></button>
      <button data-url="/pages/reservations/index?filter=all" bindtap="open"><image class="line-icon" src="/assets/icons/ticket.png" aria-hidden="true" /><text>{{copy.allBookings}}</text></button>
    </view></screen-section>
<screen-section wx:if="{{moduleId === 'menu'}}" presentation="{{screen.modules.menu}}"><view wx:if="{{accountGroups.length}}" class="surface services-card"><block wx:for="{{accountGroups}}" wx:key="id" wx:for-item="group"><text class="section-title {{index ? 'tools-heading' : ''}}">{{group.label}}</text><view class="service-grid"><button wx:for="{{group.entries}}" wx:key="id" class="service-entry" data-action="{{item.action}}" data-target="{{item.target}}" bindtap="openConfigured"><image class="line-icon" src="{{item.iconUrl}}" aria-hidden="true" /><text>{{item.label}}</text></button></view></block></view></screen-section>
</block>
    <button wx:if="{{!hasPrivacyEntry || !screen.modules.menu.visible}}" class="text-button" bindtap="privacy">{{copy.privacyEntry}}</button>
    <view wx:if="{{error && !sheet}}" class="notice" role="alert">{{error}}<button wx:if="{{authenticated}}" class="text-button" bindtap="load" disabled="{{busy}}">{{copy.retry}}</button></view>
  <screen-content page-id="{{screen.afterPageId}}" locale="{{locale}}" revision="{{configurationRevision}}" /></view>
  <tab-overlay wx:if="{{sheet}}" />
  <view wx:if="{{sheet}}" class="sheet-mask" bindtap="closeSheet" catchtouchmove="noop"><view class="bottom-sheet" catchtap="noop">
    <view class="sheet-heading"><text>{{sheet === 'login' ? copy.login : (sheet === 'bind' ? copy.wechatBindTitle : (sheet === 'participants' ? copy.linkedParticipants : copy.accountLabel))}}</text><button class="sheet-close" bindtap="closeSheet" disabled="{{busy && sheet !== 'login'}}" aria-label="{{copy.close}}">×</button></view>
    <view wx:if="{{info}}" class="auth-info" role="status">{{info}}</view>
    <block wx:if="{{sheet === 'login'}}">
      <text class="auth-hint">{{copy.wechatLoginHint}}</text>
      <text wx:if="{{wechatLoading}}" class="auth-hint">{{copy.wechatStatusLoading}}</text>
      <view wx:elif="{{wechatStatusFailed}}" class="auth-hint">{{copy.wechatStatusFailed}}<button class="text-button" bindtap="loadWechat" disabled="{{busy}}">{{copy.retry}}</button></view>
      <button wx:elif="{{wechat.available}}" class="primary" bindtap="signInWithWechat" loading="{{busy}}" disabled="{{busy}}">{{copy.wechatLogin}}</button>
      <text wx:else class="auth-hint">{{copy.wechatUnavailable}}</text>
      <button class="secondary" bindtap="browse">{{copy.cancelLogin}}</button>
    </block>
    <block wx:elif="{{sheet === 'bind'}}">
      <text class="account-display-name">{{accountName || copy.accountLabel}}</text>
      <text wx:if="{{wechatLoading}}" class="auth-hint">{{copy.wechatStatusLoading}}</text>
      <view wx:elif="{{wechatStatusFailed}}" class="auth-hint">{{copy.wechatStatusFailed}}<button class="text-button" bindtap="loadWechat" disabled="{{busy}}">{{copy.retry}}</button></view>
      <text wx:elif="{{wechat.linked}}" class="auth-hint">{{copy.wechatBound}}</text>
      <block wx:elif="{{wechat.available && wechat.canBind && wechat.canBindDirect}}">
        <text class="auth-hint">{{copy.wechatBindNote}}</text>
        <button class="primary" bindtap="confirmWechatBinding" loading="{{busy}}" disabled="{{busy || !account}}">{{copy.wechatBindConfirm}}</button>
      </block>
      <text wx:else class="auth-hint">{{wechat.available ? copy.wechatBindUnavailable : copy.wechatUnavailable}}</text>
      <button class="text-button auth-later" bindtap="skipWechatBinding" disabled="{{busy}}">{{copy.wechatLater}}</button>
    </block>
    <block wx:elif="{{sheet === 'participants'}}"><button wx:for="{{account.participants}}" wx:key="id" class="member-option" data-id="{{item.id}}" bindtap="participant"><image src="/assets/participant.png" class="participant-avatar" aria-hidden="true" /><text>{{item.name}}</text><view class="chevron"></view></button><text wx:if="{{!account.participants.length}}" class="muted small">{{account ? copy.noLinkNote : copy.loading}}</text></block>
    <block wx:else>
      <text class="account-display-name">{{accountName || copy.accountLabel}}</text>
      <text wx:if="{{wechatLoading}}" class="auth-hint">{{copy.wechatStatusLoading}}</text>
      <view wx:elif="{{wechatStatusFailed}}" class="auth-hint">{{copy.wechatStatusFailed}}<button class="text-button" bindtap="loadWechat" disabled="{{busy}}">{{copy.retry}}</button></view>
      <block wx:else>
        <text class="auth-hint">{{wechat.linked ? copy.wechatBound : (wechat.available ? copy.wechatUnlinked : copy.wechatUnavailable)}}</text>
        <button wx:if="{{wechat.canBind && wechat.canBindDirect}}" class="primary" bindtap="showWechatBinding" disabled="{{busy}}">{{copy.wechatBindTitle}}</button>
        <text wx:elif="{{wechat.available && !wechat.linked}}" class="auth-hint">{{copy.wechatBindUnavailable}}</text>
      </block>
      <button class="secondary" bindtap="signOut" disabled="{{busy}}">{{copy.logout}}</button>
    </block>
    <view wx:if="{{error}}" class="notice" role="alert">{{error}}</view>
  </view></view>
</view>
