<view class="portal-page parent-page">
  <app-nav />
  <view class="portal-content">
    <view class="parent-header"><button class="parent-identity" bindtap="showAccount"><image class="parent-avatar" src="/assets/parent.png" aria-hidden="true" /><text class="parent-name">{{authenticated ? (account.displayName || copy.parentAccount) : copy.signInNow}}</text><view class="chevron"></view></button><button class="parent-header-action" data-url="/pages/reservations/index" bindtap="open">{{copy.myBookings}}</button></view>
    <view class="parent-feature-row">
      <button class="intake-tile surface" data-url="/pages/register/index?source=account" bindtap="open"><text class="intake-tile-title">{{copy.intakeTitle}}</text><text class="small-pill">{{copy.intakeAction}}</text><image class="intake-watermark" src="/assets/icons/form.png" aria-hidden="true" /></button>
      <view class="children-tile surface"><view class="children-heading"><text>{{copy.myChildren}}</text><button class="text-link" bindtap="showChildren">{{copy.view}}<view class="chevron"></view></button></view><view wx:if="{{account.participants.length}}" class="children-row"><button wx:for="{{account.participants}}" wx:key="id" wx:if="{{index < 2}}" class="child-entry" data-id="{{item.id}}" bindtap="participant"><image class="child-avatar" src="/assets/child.png" aria-hidden="true" /><text>{{item.name}}</text></button></view><button wx:else class="children-empty" bindtap="showChildren"><image class="child-avatar" src="/assets/child.png" aria-hidden="true" /><text>{{authenticated ? copy.noChildren : copy.signInNow}}</text></button></view>
    </view>
    <view class="surface booking-shortcuts">
      <button data-url="/pages/reservations/index?filter=upcoming" bindtap="open"><image class="line-icon" src="/assets/icons/reservations.png" aria-hidden="true" /><text>{{copy.upcoming}}</text></button>
      <button data-url="/pages/reservations/index?filter=attended" bindtap="open"><image class="line-icon" src="/assets/icons/complete.png" aria-hidden="true" /><text>{{copy.attended}}</text></button>
      <button data-url="/pages/reservations/index?filter=cancelled" bindtap="open"><image class="line-icon" src="/assets/icons/cancel.png" aria-hidden="true" /><text>{{copy.cancelled}}</text></button>
      <button data-url="/pages/reservations/index?filter=all" bindtap="open"><image class="line-icon" src="/assets/icons/ticket.png" aria-hidden="true" /><text>{{copy.allBookings}}</text></button>
    </view>
    <view class="surface services-card">
      <text class="section-title">{{copy.courseServices}}</text>
      <view class="service-grid">
        <button class="service-entry" data-url="/pages/agenda/index" bindtap="open"><image class="line-icon" src="/assets/icons/calendar.png" aria-hidden="true" /><text>{{copy.allSchedule}}</text></button>
        <button class="service-entry" data-url="/pages/courses/index" bindtap="open"><image class="line-icon" src="/assets/icons/book.png" aria-hidden="true" /><text>{{copy.weekCourses}}</text></button>
        <button class="service-entry" data-url="/pages/mistakes/index" bindtap="open"><image class="line-icon" src="/assets/icons/report.png" aria-hidden="true" /><text>{{copy.reportsEntry}}</text></button>
        <button class="service-entry" data-url="/pages/homework/index" bindtap="open"><image class="line-icon" src="/assets/icons/practice.png" aria-hidden="true" /><text>{{copy.practiceEntry}}</text></button>
      </view>
      <text class="section-title tools-heading">{{copy.commonTools}}</text>
      <view class="service-grid">
        <button class="service-entry" data-url="/pages/register/index?source=account" bindtap="open"><image class="line-icon" src="/assets/icons/form.png" aria-hidden="true" /><text>{{copy.intakeTitle}}</text></button>
        <button class="service-entry" data-url="/pages/assessment/index" bindtap="open"><image class="line-icon" src="/assets/icons/report.png" aria-hidden="true" /><text>{{copy.assessmentBooking}}</text></button>
        <button class="service-entry" data-url="/pages/activity/index" bindtap="open"><image class="line-icon" src="/assets/icons/activity.png" aria-hidden="true" /><text>{{copy.activityBooking}}</text></button>
        <button class="service-entry" bindtap="privacy"><image class="line-icon" src="/assets/icons/privacy.png" aria-hidden="true" /><text>{{copy.privacyEntry}}</text></button>
      </view>
    </view>
    <view wx:if="{{error && !sheet}}" class="notice" role="alert">{{error}}<button wx:if="{{authenticated}}" class="text-button" bindtap="load" disabled="{{busy}}">{{copy.retry}}</button></view>
  </view>
  <view wx:if="{{sheet}}" class="sheet-mask" bindtap="closeSheet" catchtouchmove="noop"><view class="bottom-sheet" catchtap="noop">
    <view class="sheet-heading"><text>{{sheet === 'login' ? copy.login : (sheet === 'bind' ? copy.wechatBindTitle : (sheet === 'children' ? copy.myChildren : copy.parentAccount))}}</text><button class="sheet-close" bindtap="closeSheet" disabled="{{busy}}" aria-label="{{copy.close}}">×</button></view>
    <view wx:if="{{info}}" class="auth-info" role="status">{{info}}</view>
    <block wx:if="{{sheet === 'login'}}">
      <text wx:if="{{wechatLoading}}" class="auth-hint">{{copy.wechatStatusLoading}}</text>
      <view wx:elif="{{wechatStatusFailed}}" class="auth-hint">{{copy.wechatStatusFailed}}<button class="text-button" bindtap="loadWechat" disabled="{{busy}}">{{copy.retry}}</button></view>
      <button wx:elif="{{wechat.available}}" class="primary" bindtap="signInWithWechat" loading="{{busy}}" disabled="{{busy}}">{{copy.wechatLogin}}</button>
      <text wx:else class="auth-hint">{{copy.wechatUnavailable}}</text>
      <text class="auth-password-note">{{copy.loginNote}}</text>
      <label class="field-label">{{copy.identifier}}</label><input class="input" value="{{identifier}}" bindinput="identifierInput" maxlength="254" placeholder="{{copy.identifier}}" disabled="{{busy}}" />
      <label class="field-label">{{copy.password}}</label><input class="input" value="{{password}}" bindinput="passwordInput" password maxlength="128" placeholder="{{copy.password}}" disabled="{{busy}}" />
      <button class="secondary" bindtap="signIn" loading="{{busy}}" disabled="{{busy || !identifier || !password}}">{{copy.login}}</button>
    </block>
    <block wx:elif="{{sheet === 'bind'}}">
      <text class="account-display-name">{{account.displayName || copy.parentAccount}}</text>
      <text wx:if="{{wechatLoading}}" class="auth-hint">{{copy.wechatStatusLoading}}</text>
      <view wx:elif="{{wechatStatusFailed}}" class="auth-hint">{{copy.wechatStatusFailed}}<button class="text-button" bindtap="loadWechat" disabled="{{busy}}">{{copy.retry}}</button></view>
      <text wx:elif="{{wechat.linked}}" class="auth-hint">{{copy.wechatBound}}</text>
      <block wx:elif="{{wechat.available && wechat.canBind}}">
        <text class="auth-hint">{{copy.wechatBindNote}}</text>
        <label class="field-label">{{copy.password}}</label><input class="input" value="{{password}}" bindinput="passwordInput" password maxlength="128" placeholder="{{copy.password}}" disabled="{{busy}}" />
        <button class="primary" bindtap="confirmWechatBinding" loading="{{busy}}" disabled="{{busy || !account || !password}}">{{copy.wechatBindConfirm}}</button>
      </block>
      <text wx:else class="auth-hint">{{wechat.available ? copy.wechatBindUnavailable : copy.wechatUnavailable}}</text>
      <button class="text-button auth-later" bindtap="skipWechatBinding" disabled="{{busy}}">{{copy.wechatLater}}</button>
    </block>
    <block wx:elif="{{sheet === 'children'}}"><button wx:for="{{account.participants}}" wx:key="id" class="member-option" data-id="{{item.id}}" bindtap="participant"><image src="/assets/child.png" class="child-avatar" aria-hidden="true" /><text>{{item.name}}</text><view class="chevron"></view></button><text wx:if="{{!account.participants.length}}" class="muted small">{{copy.noLinkNote}}</text></block>
    <block wx:else>
      <text class="account-display-name">{{account.displayName || copy.parentAccount}}</text>
      <text wx:if="{{wechatLoading}}" class="auth-hint">{{copy.wechatStatusLoading}}</text>
      <view wx:elif="{{wechatStatusFailed}}" class="auth-hint">{{copy.wechatStatusFailed}}<button class="text-button" bindtap="loadWechat" disabled="{{busy}}">{{copy.retry}}</button></view>
      <block wx:else>
        <text class="auth-hint">{{wechat.linked ? copy.wechatBound : (wechat.available ? copy.wechatUnlinked : copy.wechatUnavailable)}}</text>
        <button wx:if="{{wechat.canBind}}" class="primary" bindtap="showWechatBinding" disabled="{{busy}}">{{copy.wechatBindTitle}}</button>
        <text wx:elif="{{wechat.available && !wechat.linked}}" class="auth-hint">{{copy.wechatBindUnavailable}}</text>
      </block>
      <button class="secondary" bindtap="signOut" disabled="{{busy}}">{{copy.logout}}</button>
    </block>
    <view wx:if="{{error}}" class="notice" role="alert">{{error}}</view>
  </view></view>
</view>
