<view class="portal-page theme-{{theme}}"><app-nav title="{{locale === 'en' ? 'My bookings' : '我的服务预约'}}" back /><view class="portal-content"><button wx:if="{{!authenticated}}" class="primary-button" bindtap="login">{{copy.login}}</button><view wx:if="{{error}}" class="notice">{{error}}<button class="text-button" bindtap="load">{{copy.retry}}</button></view><text wx:if="{{loading}}" class="loading-line">{{copy.loading}}</text><view wx:for="{{rows}}" wx:key="id" class="surface booking"><text class="section-title">{{item.title}}</text><text class="small muted">{{item.when}} · {{item.label}}</text><text class="booking-note">{{item.note}}</text><view class="actions"><button class="text-button" data-id="{{item.id}}" bindtap="action" disabled="{{busy}}">{{item.pending ? (locale === 'en' ? 'Confirm request' : '确认提交') : (locale === 'en' ? 'Refresh status' : '更新状态')}}</button><button wx:if="{{item.canReschedule}}" class="text-button" data-id="{{item.id}}" bindtap="reschedule" disabled="{{busy}}">{{locale === 'en' ? 'Reschedule' : '改期'}}</button><button wx:if="{{item.canCancel}}" class="text-button" data-id="{{item.id}}" data-action="cancel" bindtap="action" disabled="{{busy}}">{{locale === 'en' ? 'Cancel' : '取消'}}</button></view></view><empty-state wx:if="{{authenticated && !loading && !rows.length && !error}}" label="{{locale === 'en' ? 'No bookings yet' : '暂无服务预约'}}" spacious /><view class="actions"><button wx:if="{{page > 1}}" class="text-button" disabled="{{loading}}" bindtap="previous">{{locale === 'en' ? 'Previous' : '上一页'}}</button><button wx:if="{{more}}" class="text-button" disabled="{{loading}}" bindtap="next">{{locale === 'en' ? 'Next' : '下一页'}}</button></view></view></view>
