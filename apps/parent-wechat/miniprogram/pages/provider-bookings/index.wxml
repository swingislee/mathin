<view class="portal-page theme-{{theme}}"><app-nav title="{{screen.title || (locale === 'en' ? 'My bookings' : '我的服务预约')}}" back /><view class="portal-content"><screen-content description="{{screen.description}}" page-id="{{screen.beforePageId}}" locale="{{locale}}" revision="{{configurationRevision}}" /><button wx:if="{{!authenticated}}" class="primary-button" bindtap="login">{{copy.login}}</button><view wx:if="{{error}}" class="notice">{{error}}<button class="text-button" bindtap="load">{{copy.retry}}</button></view><text wx:if="{{loading}}" class="loading-line">{{copy.loading}}</text><screen-section presentation="{{screen.modules.content}}"><record-card wx:for="{{rows}}" wx:key="id" heading="{{item.title}}" status="{{item.label}}" subtitle="{{item.when}}" note="{{item.note}}" density="{{screen.modules.content.density}}"><view class="actions"><button class="text-button" data-id="{{item.id}}" bindtap="action" disabled="{{busy}}">{{item.pending ? (locale === 'en' ? 'Confirm request' : '确认提交') : (locale === 'en' ? 'Refresh status' : '更新状态')}}</button><button wx:if="{{item.canReschedule}}" class="text-button" data-id="{{item.id}}" bindtap="reschedule" disabled="{{busy}}">{{locale === 'en' ? 'Reschedule' : '改期'}}</button><button wx:if="{{item.canCancel}}" class="text-button" data-id="{{item.id}}" data-action="cancel" bindtap="action" disabled="{{busy}}">{{locale === 'en' ? 'Cancel' : '取消'}}</button></view></record-card></screen-section><empty-state wx:if="{{authenticated && !loading && !rows.length && !error}}" label="{{locale === 'en' ? 'No bookings yet' : '暂无服务预约'}}" spacious /><view class="actions"><button wx:if="{{page > 1}}" class="text-button" disabled="{{loading}}" bindtap="previous">{{locale === 'en' ? 'Previous' : '上一页'}}</button><button wx:if="{{more}}" class="text-button" disabled="{{loading}}" bindtap="next">{{locale === 'en' ? 'Next' : '下一页'}}</button></view><screen-content page-id="{{screen.afterPageId}}" locale="{{locale}}" revision="{{configurationRevision}}" /></view></view>
