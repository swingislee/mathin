<view class="page theme-{{theme}}"><screen-content description="{{screen.description}}" page-id="{{screen.beforePageId}}" locale="{{locale}}" revision="{{configurationRevision}}" />
  <text class="eyebrow">{{brandName}}</text><text wx:if="{{loading}}" class="empty">{{copy.loading}}</text>
  <text wx:if="{{locale === 'en' && task}}" class="muted small block">{{copy.originalContent}}</text>
  <screen-section presentation="{{screen.modules.task}}"><block wx:if="{{task}}"><text class="title">{{screen.title || task.title}}</text><text class="muted block">{{task.participantName}}<text wx:if="{{when}}"> · {{when}}</text></text><text class="subheading">{{copy.instructions}}</text><text class="prose">{{task.instructions || copy.noInstructions}}</text>
    <view wx:if="{{saved && !editing}}" class="form-section"><text class="tag success">{{copy.saved}}</text><text class="description">{{copy.savedNote}}</text><text class="prose">{{saved.note}}</text><button wx:for="{{saved.media}}" wx:key="id" class="list-row row" data-id="{{item.id}}" bindtap="openSaved"><text>{{copy.attachment}} {{index + 1}} · {{item.kind === 'video' ? '▶' : '▧'}}</text><text>{{copy.preview}} ↗</text></button><button class="secondary" bindtap="again">{{copy.submitAgain}}</button></view>
    <block wx:if="{{editing}}">
      <text class="muted small block">{{rulesHelp}}</text><view class="media-grid"><view wx:for="{{files}}" wx:key="key" class="media-item"><image src="{{item.thumb}}" mode="aspectFill" data-key="{{item.key}}" bindtap="preview" aria-label="{{copy.preview}}" /><text wx:if="{{item.kind === 'video'}}" class="video-mark">▶</text><button class="media-remove" data-key="{{item.key}}" bindtap="remove" disabled="{{busy || retrying}}">{{copy.remove}}</button><text wx:if="{{busy}}" class="small">{{item.progress}}%</text></view></view>
      <button wx:if="{{rules.maxFiles}}" class="secondary" bindtap="choose" disabled="{{busy || retrying || files.length >= rules.maxFiles}}">＋ {{copy.chooseMedia}}</button>
      <text class="muted small block">{{noteLabel}}</text><textarea class="input textarea" placeholder="{{noteLabel}}" value="{{note}}" bindinput="noteInput" maxlength="{{rules.maxNoteLength}}" disabled="{{busy || retrying}}" />
      <text wx:if="{{retrying}}" class="notice">{{retryHint}}</text>
      <text wx:if="{{saved}}" class="muted small">{{copy.newRecord}}</text><view wx:if="{{busy}}" class="upload-status"><text>{{copy.uploading}} {{progress}}%</text><progress percent="{{progress}}" stroke-width="3" /></view>
      <button class="primary" bindtap="submit" loading="{{busy}}" disabled="{{busy || !canSubmit}}">{{busy ? copy.submitting : retrying ? copy.retry : copy.submit}}</button>
    </block>
  </block></screen-section><view wx:if="{{error}}" class="notice" role="alert">{{error}}<button wx:if="{{!editing || !task}}" class="text-button" bindtap="load" disabled="{{busy || loading}}">{{copy.retry}}</button></view>
<screen-content page-id="{{screen.afterPageId}}" locale="{{locale}}" revision="{{configurationRevision}}" /></view>
