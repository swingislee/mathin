<view class="portal-page"><app-nav title="{{t.title}}" back /><view class="portal-content course-content">
  <view class="surface course-summary"><text class="muted small">{{t.grade}}</text><picker mode="selector" range="{{stages}}" range-key="label" value="{{selected}}" bindchange="change"><view class="course-student"><text>{{stages[selected].label}}</text><text class="text-link">›</text></view></picker></view>
  <view wx:if="{{error}}" class="notice">{{error}}<button class="text-button" bindtap="load">{{copy.retry}}</button></view><text wx:elif="{{loading}}" class="loading-line">{{copy.loading}}</text>
  <view wx:elif="{{contact}}" class="surface course-summary advisor-card"><text class="course-heading">{{contact.teacherName || t.advisor}}</text><image class="advisor-qr" src="{{contact.qrCodeUrl}}" mode="aspectFit" show-menu-by-longpress bindtap="preview" /><text class="small muted block">{{t.scan}}</text><text class="advisor-phone">{{contact.phone}}</text><button class="primary" bindtap="phone">{{t.phone}}</button></view>
  <empty-state wx:else label="{{t.missing}}" spacious />
</view></view>
