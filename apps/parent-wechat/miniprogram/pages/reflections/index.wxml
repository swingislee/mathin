<view class="page theme-{{theme}}"><screen-content description="{{screen.description}}" page-id="{{screen.beforePageId}}" locale="{{locale}}" revision="{{configurationRevision}}" />
  <text class="eyebrow">{{brandName}}</text><text class="title">{{screen.title || title}}</text><text class="description">{{description}}</text>
  <text wx:if="{{locale === 'en' && reports.length}}" class="muted small block">{{copy.originalContent}}</text>
  <view wx:if="{{!authenticated}}" class="empty"><text class="block">{{copy.loginRequired}}</text><text class="muted block">{{copy.loginRequiredNote}}</text><button class="primary" bindtap="login">{{copy.login}}</button></view>
  <view wx:elif="{{error}}" class="notice" role="alert">{{error}}<button class="text-button" bindtap="load">{{copy.retry}}</button></view>
  <text wx:elif="{{loading}}" class="empty">{{copy.loading}}</text>
  <view wx:elif="{{!reports.length}}" class="empty"><text class="block">{{copy.noReports}}</text><text class="muted block">{{copy.noReportsNote}}</text></view>
  <screen-section presentation="{{screen.modules.content}}"><record-card wx:for="{{reports}}" wx:key="id" heading="{{item.title}}" status="{{item.kind === 'assessment' ? copy.assessment : copy.feedback}}" subtitle="{{item.when}}" participant="{{item.participantName}}" note="{{expanded !== item.id ? item.preview : ''}}" density="{{screen.modules.content.density}}"><view wx:if="{{expanded === item.id}}">
      <text wx:if="{{item.validity}}" class="notice block">{{item.validity}}</text><content-document wx:if="{{item.contentDocument}}" document="{{item.contentDocument}}" context="{{item.context}}" images="{{item.images}}" locale="{{locale}}" />
      <block wx:else wx:for="{{item.sections}}" wx:for-item="section" wx:key="source"><view wx:if="{{section.type === 'score'}}" class="result-score"><text>{{section.label}}</text><text>{{section.text}}</text></view><block wx:else><text class="subheading">{{section.label}}</text><text class="prose">{{section.text}}</text></block></block>
    </view><button class="text-button align-left" data-id="{{item.id}}" bindtap="toggle">{{expanded === item.id ? copy.collapse : copy.details}}</button>
  </record-card></screen-section>
<screen-content page-id="{{screen.afterPageId}}" locale="{{locale}}" revision="{{configurationRevision}}" /></view>
