<view class="portal-page theme-{{theme}}"><app-nav title="{{screen.title || (title || (locale === 'en' ? 'Service request' : '服务申请'))}}" back /><view class="portal-content"><screen-content description="{{screen.description}}" page-id="{{screen.beforePageId}}" locale="{{locale}}" revision="{{configurationRevision}}" /><view wx:if="{{!authenticated}}" class="surface form-header"><text>{{locale === 'en' ? 'Sign in to submit and track your request.' : '登录后即可填写并查看申请进度。'}}</text><button class="primary-button" bindtap="login">{{copy.login}}</button></view><text wx:if="{{loading}}" class="loading-line">{{copy.loading}}</text><view wx:if="{{error}}" class="notice">{{error}}</view>
<screen-section presentation="{{screen.modules.form}}"><block wx:if="{{sent}}"><view class="surface form-header"><text class="section-title">{{locale === 'en' ? 'Submission received' : '提交已收到'}}</text><text class="form-introduction">{{sent.form.successMessage[locale] || sent.form.successMessage.zh}}</text></view><content-document wx:if="{{sent.confirmation}}" document="{{sent.confirmation}}" images="{{sent.images}}" locale="{{locale}}" /><button wx:if="{{sent.completionAction.kind !== 'none'}}" class="primary-button" bindtap="complete">{{sent.completionAction.label[locale] || sent.completionAction.label.zh}}</button><button class="text-button" bindtap="requests">{{locale === 'en' ? 'View my requests' : '查看我的服务申请'}}</button></block>
<block wx:elif="{{form}}"><view class="form-header"><text class="section-title">{{title}}</text><text class="form-introduction">{{introduction}}</text></view><view wx:if="{{detail.flow.requireParticipant || detail.flow.allowMultipleParticipants}}" class="participant-list"><text class="section-title">{{locale === 'en' ? 'Participants' : '参与人'}}</text><participant-picker rows="{{participants}}" selected-ids="{{selectedIds}}" multiple disabled="{{busy || !!pending}}" bindchange="participant" /><text wx:if="{{!participants.length}}" class="notice">{{locale === 'en' ? 'Add a participant from your account first.' : '请先在「我的」中添加或关联参与人。'}}</text></view><experience-form form="{{form}}" answers="{{answers}}" errors="{{errors}}" locale="{{locale}}" disabled="{{busy || !!pending}}" bindchange="change" /><view wx:for="{{consents}}" wx:key="id" class="consent-block"><text class="section-title">{{item.title}}</text><scroll-view scroll-y class="consent-body"><text>{{item.body}}</text></scroll-view><checkbox-group data-id="{{item.id}}" bindchange="consent"><label><checkbox value="yes" checked="{{item.accepted}}" disabled="{{busy || !!pending}}" /><text>{{locale === 'en' ? 'I have read and agree' : '我已阅读并同意'}}</text></label></checkbox-group></view></block></screen-section>
<button wx:if="{{!sent && (form || pending)}}" class="primary-button submit" loading="{{busy}}" disabled="{{busy || loading}}" bindtap="submit">{{pending ? (locale === 'en' ? 'Confirm previous submission' : '确认上次提交') : submitLabel}}</button><button wx:if="{{authenticated && !sent}}" class="text-button" bindtap="requests">{{locale === 'en' ? 'My requests' : '我的服务申请'}}</button><screen-content page-id="{{screen.afterPageId}}" locale="{{locale}}" revision="{{configurationRevision}}" /></view></view>
