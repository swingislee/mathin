<web-view wx:if="{{url && !failed}}" src="{{url}}" binderror="failed" />
<view wx:else class="portal-page theme-{{theme}}"><app-nav title="{{screen.title || (title || brandName)}}" back /><view class="portal-content"><screen-content description="{{screen.description}}" page-id="{{screen.beforePageId}}" locale="{{locale}}" revision="{{configurationRevision}}" /><text wx:if="{{loading}}" class="loading-line">{{copy.loading}}</text><text wx:if="{{error}}" class="notice">{{error}}</text><screen-section presentation="{{screen.modules.content}}"><view wx:if="{{failed}}" class="surface"><text>{{message || (locale === 'en' ? 'Open this website with the link below.' : '可复制链接后打开此网站。')}}</text><button class="primary-button" bindtap="copyLink">{{locale === 'en' ? 'Copy website link' : '复制网站链接'}}</button></view><button class="text-button" bindtap="back">{{locale === 'en' ? 'Return' : '返回'}}</button></screen-section><screen-content page-id="{{screen.afterPageId}}" locale="{{locale}}" revision="{{configurationRevision}}" /></view></view>
