<view class="portal-page course-selection-page"><app-nav title="{{t.selection}}" back />
  <view class="portal-content course-content">
    <view wx:if="{{error}}" class="notice">{{error}}<button wx:if="{{!pending}}" class="text-button" disabled="{{busy}}" bindtap="load">{{copy.retry}}</button></view>
    <button wx:if="{{!authenticated}}" class="primary" bindtap="login">{{t.login}}</button><text wx:elif="{{loading}}" class="loading-line">{{copy.loading}}</text>
    <view wx:if="{{sent}}" class="surface course-summary"><text class="course-heading">{{t.success}}</text><text class="muted block">{{t.submitNote}}</text><button class="primary" bindtap="applications">{{t.view}}</button></view>
    <block wx:elif="{{offer && !loading}}">
      <view class="surface course-summary"><text class="course-heading">{{offer.title}}</text><picker mode="selector" range="{{participants}}" range-key="name" value="{{selected}}" bindchange="participant" disabled="{{busy || pending}}"><view class="course-student"><text>{{participants[selected].name || t.selectStudent}}</text><text class="text-link">{{t.switchStudent}} ›</text></view></picker><text wx:if="{{!participants.length}}" class="notice">{{t.studentNeeded}}</text></view>
      <view wx:if="{{offer.activity}}" class="surface course-summary"><text class="section-title">{{t.activity}}</text><text class="block">{{activityWhen}}</text><text class="muted block">{{offer.activity.location}}</text></view>
      <text class="small muted block">{{t.submitNote}}</text>
    </block>
  </view>
  <view wx:if="{{authenticated && !sent}}" class="course-selection-bottom"><view class="course-submit-row"><button class="text-button" bindtap="applications">{{t.applications}}</button><button class="primary" loading="{{busy}}" disabled="{{busy || loading || (!pending && (!offer || !participants.length))}}" bindtap="submit">{{pending ? t.retry : t.apply}}</button></view></view>
</view>
