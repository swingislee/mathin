<view class="portal-page course-selection-page"><app-nav title="{{t.selection}}" back />
  <view class="portal-content course-selection-content">
    <view wx:if="{{error}}" class="notice">{{error}}<button class="text-button" disabled="{{busy}}" bindtap="load">{{copy.retry}}</button></view>
    <text wx:if="{{loading}}" class="loading-line">{{copy.loading}}</text>
    <button wx:if="{{!authenticated}}" class="primary" bindtap="login">{{t.login}}</button>
    <view wx:elif="{{sent}}" class="surface course-summary"><text class="course-heading">{{t.success}}</text><text class="muted block">{{t.submitNote}}</text><button class="primary" bindtap="applications">{{t.view}}</button></view>
    <block wx:elif="{{offer && !loading}}">
      <view class="surface course-summary"><text class="course-heading">{{offer.title}}</text><picker mode="selector" range="{{participants}}" range-key="name" value="{{selected}}" bindchange="participant" disabled="{{busy || pending}}"><view class="course-student"><text>{{participants[selected].name || t.selectStudent}}</text><text class="text-link">{{t.switchStudent}} ›</text></view></picker><text wx:if="{{!participants.length}}" class="notice">{{t.studentNeeded}}</text></view>
      <view id="choose-level" class="course-choice-section"><text class="section-title">{{t.level}}</text><view class="option-grid"><button wx:for="{{levels}}" wx:key="id" disabled="{{busy || pending}}" data-key="level" data-id="{{item.id}}" bindtap="filter" class="option-pill {{level === item.id ? 'selected' : ''}}">{{item.name}}</button></view></view>
      <view id="choose-campus" class="course-choice-section"><text class="section-title">{{t.campus}}</text><view class="option-grid"><button wx:for="{{campuses}}" wx:key="id" disabled="{{busy || pending}}" data-key="campus" data-id="{{item.id}}" bindtap="filter" class="option-pill {{campus === item.id ? 'selected' : ''}}">{{item.name}}</button></view></view>
      <view id="choose-teacher" class="course-choice-section"><text class="section-title">{{t.teacher}}</text><view class="option-grid"><button wx:for="{{teachers}}" wx:key="id" disabled="{{busy || pending}}" data-key="teacher" data-id="{{item.id}}" bindtap="filter" class="option-pill {{teacher === item.id ? 'selected' : ''}}">{{item.name}}</button></view><text wx:if="{{!teachers.length}}" class="small muted">{{t.pendingTeacher}}</text></view>
      <view id="choose-time" class="course-choice-section"><text class="section-title">{{t.time}}</text><text class="small muted block">{{t.dateNote}}</text>
        <scroll-view wx:if="{{grid.days.length}}" scroll-x class="course-time-scroll"><view class="course-time-table" style="min-width:{{130 + grid.days.length * 175}}rpx"><view class="course-time-row"><view class="course-time-label"></view><view wx:for="{{grid.days}}" wx:key="id" class="course-time-cell course-day">{{item.label}}</view></view>
          <view wx:for="{{grid.rows}}" wx:key="time" wx:for-item="row" class="course-time-row"><view class="course-time-label">{{row.time}}</view><view wx:for="{{row.cells}}" wx:key="day" wx:for-item="cell" class="course-time-cell"><button wx:for="{{cell.choices}}" wx:key="id" wx:for-item="choice" class="course-slot {{classId === choice.id ? 'selected' : ''}}" disabled="{{busy || pending || choice.full}}" data-id="{{choice.id}}" bindtap="chooseClass"><text>{{choice.name}}</text><text class="block small">{{choice.full ? t.full : t.available}}</text></button><text wx:if="{{!cell.choices.length}}" class="muted">—</text></view></view>
        </view></scroll-view>
        <button wx:for="{{unscheduled}}" wx:key="id" class="course-unscheduled option-pill {{classId === item.id ? 'selected' : ''}}" disabled="{{busy || pending || item.full}}" data-id="{{item.id}}" bindtap="chooseClass">{{item.name}} · {{t.pendingSchedule}} · {{item.full ? t.full : t.available}}</button>
        <empty-state wx:if="{{!matched}}" label="{{t.noMatch}}" />
      </view>
      <view wx:if="{{classLabel}}" class="surface course-summary"><text class="section-title">{{t.selected}}</text><text class="small block">{{classLabel}}</text></view>
      <text class="small muted block">{{t.submitNote}}</text>
    </block>
  </view>
  <view wx:if="{{authenticated && !sent}}" class="course-selection-bottom"><view class="course-quick"><text>{{t.quick}}</text><button class="text-button" disabled="{{busy || pending}}" bindtap="reset">↻ {{t.reset}}</button></view><view class="course-quick-grid"><button data-section="level" bindtap="jump">{{t.level}}</button><button data-section="campus" bindtap="jump">{{t.campus}}</button><button data-section="teacher" bindtap="jump">{{t.teacher}}</button><button data-section="time" bindtap="jump">{{t.time}}</button></view><view class="course-submit-row"><button class="text-button" bindtap="applications">{{t.applications}}</button><button class="primary" loading="{{busy}}" disabled="{{busy || loading || (!pending && (!classId || !participants.length))}}" bindtap="submit">{{pending ? t.retry : t.apply}}</button></view></view>
</view>
