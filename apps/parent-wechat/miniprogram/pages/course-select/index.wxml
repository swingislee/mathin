<view class="portal-page course-selection-page"><app-nav title="{{t.selection}}" back />
  <view class="portal-content course-content">
    <view wx:if="{{error}}" class="notice">{{error}}<button wx:if="{{!pending}}" class="text-button" disabled="{{busy}}" bindtap="load">{{copy.retry}}</button></view>
    <button wx:if="{{!authenticated}}" class="primary" bindtap="login">{{t.login}}</button><text wx:elif="{{loading}}" class="loading-line">{{copy.loading}}</text>
    <view wx:if="{{sent}}" class="surface course-summary"><text class="course-heading">{{t.success}}</text><text class="muted block">{{t.submitNote}}</text><button class="primary" bindtap="applications">{{t.view}}</button></view>
    <block wx:elif="{{offer && !loading}}">
      <view class="surface course-summary"><text class="course-heading">{{offer.title}}</text><picker mode="selector" range="{{participants}}" range-key="name" value="{{selected}}" bindchange="participant" disabled="{{busy || pending}}"><view class="course-student"><text>{{participants[selected].name || t.selectStudent}}</text><text class="text-link">{{t.switchStudent}} ›</text></view></picker><text wx:if="{{!participants.length}}" class="notice">{{t.studentNeeded}}</text></view>
      <view wx:if="{{offer.activity}}" class="surface course-summary"><text class="section-title">{{t.activity}}</text><text class="block">{{activityWhen}}</text><text class="muted block">{{offer.activity.location}}</text></view>
      <view wx:for="{{classViews}}" wx:key="id" class="surface course-summary"><text class="section-title">{{item.name}}</text><view id="choose-level" class="course-choice-section"><text class="small muted">{{t.level}}</text><text class="block">{{item.level || '—'}}</text></view><view id="choose-campus" class="course-choice-section"><text class="small muted">{{t.campus}}</text><text class="block">{{item.campusName || t.pendingCampus}}{{item.roomName ? ' · ' + item.roomName : ''}}</text></view><view id="choose-teacher" class="course-choice-section"><text class="small muted">{{t.teacher}}</text><text class="block">{{item.teacherNames || t.pendingTeacher}}</text></view><view id="choose-time" class="course-choice-section"><text class="small muted">{{t.time}}</text><text class="block">{{item.times}}</text></view><button wx:if="{{classViews.length > 1}}" class="option-pill {{classId === item.id ? 'selected' : ''}}" disabled="{{busy || pending}}" data-id="{{item.id}}" bindtap="chooseClass">{{t.available}}</button></view>
      <text class="small muted block">{{t.submitNote}}</text>
    </block>
  </view>
  <view wx:if="{{authenticated && !sent}}" class="course-selection-bottom"><block wx:if="{{offer && offer.kind === 'class'}}"><view class="course-quick"><text>{{t.quick}}</text></view><view class="course-quick-grid"><button data-section="level" bindtap="jump">{{t.level}}</button><button data-section="campus" bindtap="jump">{{t.campus}}</button><button data-section="teacher" bindtap="jump">{{t.teacher}}</button><button data-section="time" bindtap="jump">{{t.time}}</button></view></block><view class="course-submit-row"><button class="text-button" bindtap="applications">{{t.applications}}</button><button class="primary" loading="{{busy}}" disabled="{{busy || loading || (!pending && (!offer || (offer.kind === 'class' && !classId) || !participants.length))}}" bindtap="submit">{{pending ? t.retry : t.apply}}</button></view></view>
</view>
