<view class="portal-page calendar-page">
  <app-nav title="{{title}}" />
  <view class="portal-content">
    <view class="participant-header"><image class="participant-avatar" src="/assets/participant.png" aria-hidden="true" /><view class="participant-info"><view class="participant-name-row"><text wx:if="{{participants.length || !authenticated || loaded}}" class="participant-name">{{participants[selected].name || copy.chooseLinkedParticipant}}</text><view wx:else class="identity-placeholder" aria-label="{{copy.loading}}" /><button class="switch-participant" bindtap="showParticipants">{{copy.switchParticipant}}<text>▾</text></button></view><text wx:if="{{stageLabel}}" class="participant-stage">{{stageLabel}}</text></view></view>
    <view class="surface week-card">
      <view class="card-heading"><text class="section-title">{{copy.weekCalendar}}</text><button class="text-link subtle" bindtap="agenda">{{copy.allArrangements}}<view class="chevron"></view></button></view>
      <view class="week-strip"><button wx:for="{{days}}" wx:key="date" class="week-day {{item.selected ? 'selected' : ''}}" data-date="{{item.date}}" bindtap="day"><text class="week-day-label">{{weekdays[item.weekday]}}</text><text class="week-day-number">{{item.today ? copy.todayShort : item.day}}</text><view wx:if="{{item.count}}" class="day-dot"></view></button></view>
      <view wx:if="{{!authenticated}}" class="inline-signin"><button class="primary" bindtap="login">{{copy.loginCalendar}}</button></view>
      <text wx:elif="{{loading && !loaded}}" class="loading-line">{{copy.loading}}</text>
      <view wx:elif="{{error}}" class="notice" role="alert">{{error}}<button class="text-button" bindtap="load">{{copy.retry}}</button></view>
      <empty-state wx:elif="{{loaded && !daySessions.length}}" label="{{participants.length ? copy.noDayEntries : copy.noLinkNote}}" compact />
      <view wx:for="{{daySessions}}" wx:key="key" class="entry-card {{item.phase === 'ended' ? 'entry-ended' : ''}}"><view class="entry-time"><text class="entry-status">{{copy[item.phase]}}</text><text class="entry-start">{{item.startTime}}</text><text wx:if="{{item.endTime}}" class="entry-end">~{{item.endTime}}</text></view><view class="entry-content"><text class="entry-title">{{item.title}}</text><text class="entry-meta">{{item.detail || (item.kind === 'activity' ? copy.locationPending : '')}}{{item.facilitator ? ' | ' + item.facilitator : ''}}</text><text wx:if="{{item.kind === 'activity'}}" class="entry-kind">{{copy.activityArrangement}}</text></view></view>
    </view>
  </view>
  <tab-overlay wx:if="{{sheet}}" />
  <view wx:if="{{sheet}}" class="sheet-mask" bindtap="closeSheet" catchtouchmove="noop"><view class="bottom-sheet" catchtap="noop"><view class="sheet-heading"><text>{{copy.chooseLinkedParticipant}}</text><button class="sheet-close" bindtap="closeSheet" aria-label="{{copy.close}}">×</button></view><button wx:for="{{participants}}" wx:key="id" class="member-option {{index === selected ? 'selected' : ''}}" data-index="{{index}}" bindtap="participant"><image src="/assets/participant.png" class="participant-avatar" aria-hidden="true" /><text>{{item.name}}</text><text wx:if="{{index === selected}}" class="member-check">✓</text></button><text wx:if="{{!participants.length}}" class="muted small">{{loaded ? copy.noLinkNote : copy.loading}}</text></view></view>
</view>
