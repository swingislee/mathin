<view class="page">
  <text class="eyebrow">{{brandName}}</text><text wx:if="{{loading && !activity}}" class="empty">{{copy.loading}}</text>
  <block wx:if="{{activity}}"><text class="title">{{activity.label}}</text><text class="prose description">{{activity.body}}</text>
    <view class="detail-list"><view class="detail-row"><text class="muted">{{copy.time}}</text><text>{{activity.when}}</text></view><view class="detail-row"><text class="muted">{{copy.place}}</text><text>{{activity.location}}</text></view><view wx:if="{{activity.durationMinutes}}" class="detail-row"><text>{{activity.durationMinutes}} {{copy.minutes}}</text></view><view class="detail-row"><text class="muted">{{copy.places}}</text><text>{{activity.remaining === null ? copy.unlimited : activity.remaining}}</text></view></view>
    <block wx:if="{{authenticated}}"><text class="field-label">{{copy.participant}}</text><picker wx:if="{{participants.length}}" range="{{participants}}" range-key="name" value="{{selected}}" bindchange="change"><view class="input row"><text>{{participants[selected].name}}</text><text>⌄</text></view></picker><text wx:else class="muted block">{{copy.noParticipants}}</text></block>
    <button wx:if="{{!authenticated}}" class="primary" bindtap="login">{{copy.loginToBook}}</button><button wx:else class="primary" bindtap="book" loading="{{busy}}" disabled="{{busy || booked || !participants.length || !activity.bookable || activity.remaining === 0}}">{{booked ? copy.booked : (!activity.bookable ? copy.closed : (activity.remaining === 0 ? copy.full : copy.book))}}</button><text class="muted small block">{{copy.bookingNote}}</text>
  </block><view wx:if="{{error}}" class="notice" role="alert">{{error}}<button class="text-button" bindtap="load">{{copy.retry}}</button></view>
</view>
