<view class="page activity-detail">
  <text class="brand">{{brandName}}</text><text wx:if="{{loading && !activity}}" class="empty">{{copy.loading}}</text>
  <block wx:if="{{activity}}">
    <view class="detail-heading"><text class="tag">{{copy.activityDetail}}</text><text class="title">{{activity.label}}</text><text class="prose description muted">{{activity.body}}</text></view>
    <view class="detail-list"><view class="detail-row"><text class="muted">{{copy.time}}</text><text>{{activity.when}}</text></view><view class="detail-row"><text class="muted">{{copy.place}}</text><text>{{activity.location || copy.locationPending}}</text></view><view wx:if="{{activity.durationMinutes}}" class="detail-row"><text>{{activity.durationMinutes}} {{copy.minutes}}</text></view><view class="detail-row"><text class="muted">{{copy.places}}</text><text>{{activity.remaining === null ? copy.unlimited : activity.remaining}}</text></view></view>
    <view wx:if="{{authenticated && participants.length}}"><text class="field-label">{{copy.participant}}</text><picker wx:if="{{participants.length}}" range="{{participants}}" range-key="name" value="{{selected}}" bindchange="change" disabled="{{busy || loading || uncertain}}"><view class="input row"><text>{{participants[selected].name}}</text><text>⌄</text></view></picker></view>
    <view wx:if="{{booked}}" class="success-panel" role="status"><text class="success-symbol" aria-hidden="true">✓</text><text class="row-title">{{copy.reservationSaved}}</text><text class="small muted block">{{participants[selected].name}}</text><text class="small muted block">{{copy.reservationSavedNote}}</text><button class="primary" bindtap="reservations">{{copy.viewReservations}}</button></view>
    <block wx:elif="{{authenticated}}">
      <view class="step-indicator"><text class="{{step === 1 ? 'current-step' : ''}}">{{copy.bookingStepOne}}</text><view class="step-line"></view><text class="{{step === 2 ? 'current-step' : ''}}">{{copy.bookingStepTwo}}</text></view>
      <block wx:if="{{step === 1}}"><text wx:if="{{!participants.length}}" class="muted prose">{{loading ? copy.loading : copy.noLinkNote}}</text>
        <button class="primary" bindtap="review" disabled="{{busy || loading || uncertain || !loaded || !participants.length || !activity.bookable || activity.remaining === 0}}">{{!activity.bookable ? copy.closed : (activity.remaining === 0 ? copy.full : copy.nextStep)}}</button>
      </block>
      <block wx:else><view class="confirmation-panel"><text class="eyebrow">{{copy.selectedParticipant}}</text><text class="row-title">{{participants[selected].name}}</text><text class="small muted block">{{copy.confirmReservationNote}}</text></view><button class="primary" bindtap="book" loading="{{busy}}" disabled="{{busy || uncertain || !loaded}}">{{copy.confirmReservation}}</button><button class="secondary" bindtap="back" disabled="{{busy || uncertain}}">{{copy.backStep}}</button></block>
    </block>
    <view wx:else class="signin-panel"><text class="small muted block">{{copy.reservationLoginNote}}</text><button class="primary" bindtap="login">{{copy.loginToBook}}</button><text class="subheading">{{copy.newVisitor}}</text><text class="small muted block">{{copy.newVisitorNote}}</text><button class="text-button" bindtap="register">{{copy.intakeAction}} →</button></view>
  </block>
  <view wx:if="{{error}}" class="notice" role="alert">{{error}}<button wx:if="{{uncertain}}" class="text-button" bindtap="reservations">{{copy.viewReservations}}</button><button wx:else class="text-button" bindtap="load" disabled="{{busy}}">{{copy.retry}}</button></view>
</view>
