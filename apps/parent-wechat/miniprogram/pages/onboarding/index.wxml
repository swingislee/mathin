<view class="portal-page onboarding-page">
  <app-nav />
  <view class="portal-content onboarding-content">
    <text class="onboarding-eyebrow">格致未来思维</text>
    <text class="onboarding-title">{{stage === 'family' ? formTitle : words.title}}</text>
    <text class="onboarding-intro">{{stage === 'family' ? formDescription : words.intro}}</text>
    <block wx:if="{{stage === 'wechat'}}"><text wx:if="{{busy}}" class="auth-hint">{{words.busy}}</text><button wx:else class="primary" bindtap="start">{{words.retry}}</button></block>
    <block wx:elif="{{stage === 'phone'}}">
      <text class="auth-hint">{{words.phoneNote}}</text>
      <button class="primary" open-type="getPhoneNumber" bindgetphonenumber="phone" disabled="{{busy}}" loading="{{busy}}">{{words.phone}}</button>
      <button class="text-button" bindtap="privacy">{{words.privacyButton}}</button>
    </block>
    <block wx:elif="{{stage === 'family'}}">
      <text class="verified-phone">{{words.verifiedPhone}} · {{maskedPhone}}</text>
      <block wx:for="{{fields}}" wx:key="id">
        <label class="field-label">{{item.text}}<text class="field-requirement">{{item.mode === 'required' ? (locale === 'zh' ? '（必填）' : ' (required)') : (locale === 'zh' ? '（选填）' : ' (optional)')}}</text></label>
        <input wx:if="{{item.kind === 'text'}}" class="input" value="{{values[item.id]}}" bindinput="input" data-field="{{item.id}}" maxlength="{{item.id === 'school' ? 120 : 100}}" disabled="{{busy}}" />
        <picker wx:elif="{{item.kind === 'picker'}}" range="{{choices[item.id]}}" value="{{selection[item.id]}}" bindchange="picker" data-field="{{item.id}}" disabled="{{busy}}"><view class="input picker-input">{{choices[item.id][selection[item.id]]}}</view></picker>
        <checkbox-group wx:else bindchange="chooseInterests" class="interest-options"><label wx:for="{{item.choices}}" wx:for-item="option" wx:key="id"><checkbox value="{{option.id}}" checked="{{selectedInterests[option.id]}}" disabled="{{busy}}" />{{option.text}}</label></checkbox-group>
      </block>
      <checkbox-group bindchange="consent"><label class="onboarding-consent"><checkbox value="yes" checked="{{consent}}" disabled="{{busy}}" /><text>{{words.consent}}</text></label></checkbox-group>
      <view class="policy-links"><button class="text-button" bindtap="policy" data-kind="privacy">{{words.privacy}}</button><button class="text-button" bindtap="policy" data-kind="children">{{words.childrenPrivacy}}</button></view>
      <text class="auth-hint">{{words.locationNote}}</text>
      <button class="primary" bindtap="complete" loading="{{busy}}" disabled="{{busy}}">{{words.complete}}</button>
    </block>
    <view wx:if="{{error}}" class="notice" role="alert">{{error}}</view>
  </view>
</view>
