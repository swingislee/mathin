.binding-content { padding-top: 40rpx; padding-bottom: 80rpx; }
.binding-title { display: block; font-size: 44rpx; line-height: 1.4; }
.binding-intro { display: block; color: var(--muted); font-size: 28rpx; line-height: 1.8; margin: 24rpx 0; }
.binding-name { display: block; margin-top: 36rpx; font-size: 52rpx; }
.binding-meta { display: block; margin: 16rpx 0; font-size: 25rpx; color: var(--muted); }
.picker-input { display: flex; align-items: center; min-height: 80rpx; }
.binding-consent { display: flex; align-items: flex-start; font-size: 25rpx; line-height: 1.8; margin-bottom: 24rpx; }
.policy-links { display: flex; flex-wrap: wrap; gap: 16rpx; margin-top: 20rpx; }
.policy-links .text-button { margin: 0; font-size: 25rpx; }
