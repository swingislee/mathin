<view class="portal-page theme-{{theme}}"><app-nav title="{{t.applications}}" back /><view class="portal-content">
  <view class="application-filters"><button wx:for="{{statuses}}" wx:key="id" class="{{filter === item.id ? 'selected' : ''}}" data-id="{{item.id}}" bindtap="filter">{{item.label}}</button></view>
  <view wx:if="{{error}}" class="notice">{{error}}<button class="text-button" disabled="{{busy}}" bindtap="load">{{copy.retry}}</button></view>
  <button wx:if="{{!authenticated}}" class="primary" bindtap="login">{{copy.signInNow}}</button><text wx:elif="{{loading}}" class="loading-line">{{copy.loading}}</text>
  <empty-state wx:elif="{{!rows.length && !error}}" label="{{t.historyEmpty}}" spacious />
  <view wx:for="{{rows}}" wx:key="id" class="surface activity-summary"><view class="card-heading"><text class="section-title">{{item.title}}</text><text class="small muted">{{item.statusLabel}}</text></view><text class="block">{{item.participantName}}</text><text class="small muted block">{{item.dateLabel}}</text><text wx:if="{{item.reply}}" class="activity-description block">{{item.reply}}</text><button wx:if="{{item.hasAnswers}}" class="text-button" disabled="{{answersBusy}}" data-id="{{item.id}}" bindtap="showAnswers">{{item.expanded ? (locale === 'en' ? 'Hide answers' : '收起报名回答') : (locale === 'en' ? 'View answers' : '查看报名回答')}}</button><view wx:if="{{item.expanded}}" wx:for="{{item.answers}}" wx:for-item="answer" wx:key="label"><text class="small muted block">{{answer.label}}</text><text class="activity-notice-copy">{{answer.value}}</text></view><button wx:if="{{item.canCancel}}" class="text-button" disabled="{{busy}}" data-id="{{item.id}}" bindtap="cancel">{{t.cancel}}</button></view>
</view></view>
