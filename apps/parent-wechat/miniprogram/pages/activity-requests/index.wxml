<view class="portal-page theme-{{theme}}"><app-nav title="{{screen.title || (t.applications)}}" back /><view class="portal-content"><screen-content description="{{screen.description}}" page-id="{{screen.beforePageId}}" locale="{{locale}}" revision="{{configurationRevision}}" />
  <screen-section presentation="{{screen.modules.filters}}"><filter-tabs options="{{statuses}}" value="{{filter}}" disabled="{{busy}}" bindchange="filter" /></screen-section>
  <view wx:if="{{error}}" class="notice">{{error}}<button class="text-button" disabled="{{busy}}" bindtap="load">{{copy.retry}}</button></view>
  <button wx:if="{{!authenticated}}" class="primary" bindtap="login">{{copy.signInNow}}</button><text wx:elif="{{loading}}" class="loading-line">{{copy.loading}}</text>
  <empty-state wx:elif="{{!rows.length && !error}}" label="{{t.historyEmpty}}" spacious />
  <screen-section presentation="{{screen.modules.content}}"><record-card wx:for="{{rows}}" wx:key="id" heading="{{item.title}}" status="{{item.statusLabel}}" participant="{{item.participantName}}" subtitle="{{item.dateLabel}}" note="{{item.reply}}" density="{{screen.modules.content.density}}"><button wx:if="{{item.hasAnswers}}" class="text-button" disabled="{{answersBusy}}" data-id="{{item.id}}" bindtap="showAnswers">{{item.expanded ? (locale === 'en' ? 'Hide answers' : '收起报名回答') : (locale === 'en' ? 'View answers' : '查看报名回答')}}</button><answer-list wx:if="{{item.expanded}}" rows="{{item.answers}}" /><button wx:if="{{item.canCancel}}" class="text-button" disabled="{{busy}}" data-id="{{item.id}}" bindtap="cancel">{{t.cancel}}</button></record-card></screen-section>
<screen-content page-id="{{screen.afterPageId}}" locale="{{locale}}" revision="{{configurationRevision}}" /></view></view>
