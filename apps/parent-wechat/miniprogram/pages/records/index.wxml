<view class="page theme-{{theme}}"><screen-content description="{{screen.description}}" page-id="{{screen.beforePageId}}" locale="{{locale}}" revision="{{configurationRevision}}" />
  <text class="eyebrow">{{brandName}}</text><text class="title">{{screen.title || title}}</text><text class="description">{{description}}</text>
  <text wx:if="{{locale === 'en' && tasks.length}}" class="muted small block">{{copy.originalContent}}</text>
  <view wx:if="{{!authenticated}}" class="empty"><text class="block">{{copy.loginRequired}}</text><text class="muted block">{{copy.loginRequiredNote}}</text><button class="primary" bindtap="login">{{copy.login}}</button></view>
  <view wx:elif="{{error}}" class="notice" role="alert">{{error}}<button class="text-button" bindtap="load">{{copy.retry}}</button></view>
  <text wx:elif="{{loading}}" class="empty">{{copy.loading}}</text>
  <view wx:elif="{{!tasks.length}}" class="empty"><text class="block">{{copy.noTasks}}</text><text class="muted block">{{copy.noTasksNote}}</text></view>
  <screen-section presentation="{{screen.modules.content}}"><record-card wx:for="{{tasks}}" wx:key="key" heading="{{item.title}}" status="{{item.submittedAt ? copy.submitted : copy.pending}}" participant="{{item.participantName}}" subtitle="{{item.when ? copy.due + ' · ' + item.when : ''}}" interactive data-id="{{item.id}}" data-participant="{{item.participantId}}" bindselect="open" density="{{screen.modules.content.density}}" /></screen-section>
<screen-content page-id="{{screen.afterPageId}}" locale="{{locale}}" revision="{{configurationRevision}}" /></view>
