<view class="portal-page theme-{{theme}}"><app-nav title="{{t.title}}" back /><view class="portal-content activity-content">
  <view class="surface activity-summary"><text class="muted small">{{t.stageNumber}}</text><picker mode="selector" range="{{stages}}" range-key="label" value="{{selected}}" bindchange="change"><view class="activity-participant"><text>{{stages[selected].label}}</text><text class="text-link">›</text></view></picker></view>
  <view wx:if="{{campuses.length > 1}}" class="surface activity-summary"><text class="muted small">{{t.campus}}</text><picker mode="selector" range="{{campuses}}" range-key="name" value="{{campusSelected}}" bindchange="changeCampus"><view class="activity-participant"><text>{{campuses[campusSelected].name}}</text><text class="text-link">›</text></view></picker></view>
  <view wx:if="{{error}}" class="notice">{{error}}<button class="text-button" bindtap="load">{{copy.retry}}</button></view><text wx:elif="{{loading}}" class="loading-line">{{copy.loading}}</text>
  <block wx:elif="{{contacts.length}}"><view wx:for="{{contacts}}" wx:key="key" class="surface activity-summary service-card"><text class="activity-heading">{{item.nameText || t.service}}</text><text wx:if="{{item.serviceText}}" class="block">{{item.serviceText}}</text><text wx:if="{{item.campusName}}" class="small muted block">{{item.campusName}}</text><image wx:if="{{item.qrCodeUrl}}" class="service-qr" src="{{item.qrCodeUrl}}" mode="aspectFit" show-menu-by-longpress bindtap="preview" data-index="{{index}}" /><text wx:if="{{item.qrCodeUrl}}" class="small muted block">{{t.scan}}</text><text wx:if="{{item.hoursText}}" class="small block">{{t.hours}} · {{item.hoursText}}</text><text wx:if="{{item.addressText}}" class="small block">{{t.address}} · {{item.addressText}}</text><text wx:if="{{item.phone}}" class="service-phone">{{item.phone}}</text><button wx:if="{{item.phone}}" class="primary" bindtap="phone" data-index="{{index}}">{{t.phone}}</button></view></block>
  <empty-state wx:else label="{{t.missing}}" spacious />
</view></view>
