<view class="portal-page theme-{{theme}}"><app-nav title="{{screen.title || (t.title)}}" back /><view class="portal-content activity-content"><screen-content description="{{screen.description}}" page-id="{{screen.beforePageId}}" locale="{{locale}}" revision="{{configurationRevision}}" />
  <screen-section presentation="{{screen.modules.filters}}"><view class="surface activity-summary"><text class="muted small">{{t.stageNumber}}</text><picker mode="selector" range="{{stages}}" range-key="label" value="{{selected}}" bindchange="change"><view class="activity-participant"><text>{{stages[selected].label}}</text><text class="text-link">›</text></view></picker></view>
  <view wx:if="{{campuses.length > 1}}" class="surface activity-summary"><text class="muted small">{{t.campus}}</text><picker mode="selector" range="{{campuses}}" range-key="name" value="{{campusSelected}}" bindchange="changeCampus"><view class="activity-participant"><text>{{campuses[campusSelected].name}}</text><text class="text-link">›</text></view></picker></view></screen-section>
  <screen-section presentation="{{screen.modules.content}}"><view wx:if="{{error}}" class="notice">{{error}}<button class="text-button" bindtap="load">{{copy.retry}}</button></view><text wx:elif="{{loading}}" class="loading-line">{{copy.loading}}</text>
  <block wx:elif="{{contacts.length}}"><contact-list rows="{{contacts}}" locale="{{locale}}" density="{{screen.modules.content.density}}" /></block>
  <empty-state wx:else label="{{t.missing}}" spacious /></screen-section>
<screen-content page-id="{{screen.afterPageId}}" locale="{{locale}}" revision="{{configurationRevision}}" /></view></view>
