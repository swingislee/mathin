<view wx:if="{{!authenticated}}" class="feed-state"><text>{{locale === 'en' ? 'Sign in to view your records' : '登录后查看自己的记录'}}</text><button bindtap="login">{{locale === 'en' ? 'Sign in' : '登录'}}</button></view><text wx:elif="{{loading}}" class="feed-state">{{locale === 'en' ? 'Loading…' : '正在载入…'}}</text><view wx:elif="{{error}}" class="feed-state"><text>{{error}}</text><button bindtap="load">{{locale === 'en' ? 'Retry' : '重试'}}</button></view><text wx:elif="{{!rows.length}}" class="feed-state">{{emptyText}}</text><record-card wx:for="{{rows}}" wx:key="id" heading="{{item.title}}" status="{{item.status}}" subtitle="{{item.time}}" participant="{{item.participant}}" note="{{item.note}}" density="{{density}}" interactive data-id="{{item.id}}" bindselect="open" /><button wx:if="{{authenticated}}" class="feed-all" bindtap="all">{{locale === 'en' ? 'View all records' : '查看全部记录'}} ›</button>
