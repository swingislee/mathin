<view class="runtime-children layout-{{layout}}">
<block wx:for="{{blocks}}" wx:key="id" wx:for-item="block" wx:for-index="index">
  <view wx:if="{{block.type === 'section' && block.style === 'card'}}" class="runtime-section surface {{inCard ? '' : 'runtime-block'}}">
    <view wx:if="{{block.title || block.more}}" class="card-heading"><text class="section-title">{{block.title}}</text><button wx:if="{{block.more}}" class="text-link" data-action="{{block.more.action}}" bindtap="act">{{block.more.label}}<view class="chevron"></view></button></view>
    <runtime-blocks blocks="{{block.blocks}}" strings="{{strings}}" locale="{{locale}}" lifted="{{lifted}}" screen="{{screen}}" screen-params="{{screenParams}}" in-card bindaction="forward" bindfacet="forwardFacet" bindweek="forwardWeek" bindparticipant="forwardParticipant" bindaccount="forwardAccount" bindsheet="forwardSheet" bindsearch="forwardSearch" bindmore="forwardMore" bindrefresh="forwardRefresh" bindeffects="forwardEffects" />
  </view>
  <view wx:elif="{{block.type === 'section'}}" class="runtime-section plain {{block.style === 'row' ? 'account-feature-row' : ''}} runtime-block">
    <view wx:if="{{block.title || block.more}}" class="card-heading"><text class="section-title">{{block.title}}</text><button wx:if="{{block.more}}" class="text-link" data-action="{{block.more.action}}" bindtap="act">{{block.more.label}}<view class="chevron"></view></button></view>
    <runtime-blocks blocks="{{block.blocks}}" strings="{{strings}}" locale="{{locale}}" lifted="{{lifted}}" screen="{{screen}}" screen-params="{{screenParams}}" layout="{{block.style === 'row' ? 'row' : 'column'}}" bindaction="forward" bindfacet="forwardFacet" bindweek="forwardWeek" bindparticipant="forwardParticipant" bindaccount="forwardAccount" bindsheet="forwardSheet" bindsearch="forwardSearch" bindmore="forwardMore" bindrefresh="forwardRefresh" bindeffects="forwardEffects" />
  </view>
  <view wx:elif="{{block.type === 'tabs'}}" class="runtime-tabs runtime-block">
    <scroll-view scroll-x class="runtime-tab-scroll" enhanced show-scrollbar="{{false}}"><view class="runtime-tab-bar style-{{block.style}}">
      <button wx:for="{{block.tabs}}" wx:for-item="tab" wx:for-index="tabNumber" wx:key="id" class="runtime-tab {{tabIndex[block.id] === tabNumber ? 'active' : ''}}" data-block="{{block.id}}" data-index="{{tabNumber}}" bindtap="tab">{{tab.label}}</button>
    </view></scroll-view>
    <runtime-blocks blocks="{{block.tabs[tabIndex[block.id] || 0].blocks}}" strings="{{strings}}" locale="{{locale}}" lifted="{{lifted}}" screen="{{screen}}" screen-params="{{screenParams}}" bindaction="forward" bindfacet="forwardFacet" bindweek="forwardWeek" bindparticipant="forwardParticipant" bindaccount="forwardAccount" bindsheet="forwardSheet" bindsearch="forwardSearch" bindmore="forwardMore" bindrefresh="forwardRefresh" bindeffects="forwardEffects" />
  </view>
  <view wx:elif="{{block.type === 'collapse'}}" class="surface runtime-collapse runtime-block {{opened[block.id] ? 'open' : ''}}">
    <button class="runtime-collapse-head" data-block="{{block.id}}" bindtap="toggle" aria-expanded="{{opened[block.id]}}"><view class="runtime-collapse-copy"><text class="runtime-collapse-title">{{block.title}}</text><text wx:if="{{block.summary}}" class="runtime-collapse-summary">{{block.summary}}</text></view><view class="chevron {{opened[block.id] ? 'up' : 'down'}}"></view></button>
    <runtime-blocks wx:if="{{opened[block.id]}}" blocks="{{block.blocks}}" strings="{{strings}}" locale="{{locale}}" lifted="{{lifted}}" screen="{{screen}}" screen-params="{{screenParams}}" in-card bindaction="forward" bindfacet="forwardFacet" bindweek="forwardWeek" bindparticipant="forwardParticipant" bindaccount="forwardAccount" bindsheet="forwardSheet" bindsearch="forwardSearch" bindmore="forwardMore" bindrefresh="forwardRefresh" bindeffects="forwardEffects" />
  </view>
  <text wx:elif="{{block.type === 'text'}}" class="runtime-text tone-{{block.tone}}" user-select>{{block.text}}</text>
  <image wx:elif="{{block.type === 'image'}}" class="runtime-image fit-{{block.fit}}" src="{{block.image}}" mode="{{block.fit === 'cover' ? 'aspectFill' : 'widthFix'}}" data-action="{{block.action}}" bindtap="act" lazy-load />
  <button wx:elif="{{block.type === 'feature' && block.style === 'tile'}}" class="intake-tile surface runtime-tile" data-action="{{block.action}}" bindtap="act"><text class="intake-tile-title">{{block.title}}</text><text wx:if="{{block.body}}" class="small-pill">{{block.body}}</text><image wx:if="{{block.image}}" class="intake-watermark" src="{{block.image}}" aria-hidden="true" /></button>
  <button wx:elif="{{block.type === 'feature'}}" class="feature-entry surface configured-block {{inCard ? '' : 'runtime-block'}}" open-type="{{block.action.type === 'contact' ? 'contact' : block.action.type === 'share' ? 'share' : ''}}" data-action="{{block.action}}" bindtap="act" hover-class="pressed">
    <image class="feature-art" src="{{block.image || '/assets/appointment.png'}}" mode="aspectFit" aria-hidden="true" />
    <view class="feature-copy"><text class="feature-title">{{block.title}}</text><text wx:if="{{block.body}}" class="small-pill">{{block.body}}</text></view>
    <view wx:if="{{block.action}}" class="chevron"></view>
  </button>
  <view wx:elif="{{block.type === 'filters'}}" class="discovery-filters"><button wx:for="{{block.facets}}" wx:key="id" wx:if="{{item.kind !== 'search'}}" class="filter-pill" data-facet="{{item.id}}" data-block="{{block.id}}" bindtap="facet"><text>{{item.value ? item.valueLabel : item.label}}</text><view class="chevron down"></view></button><button wx:if="{{block.active}}" class="text-button" data-block="{{block.id}}" bindtap="clearFilters">{{block.clearLabel}}</button></view>
  <view wx:elif="{{block.type === 'entries' && block.style === 'floating'}}" class="floating-services surface {{lifted ? 'lifted' : ''}}">
    <button wx:for="{{block.items}}" wx:key="id" open-type="{{item.action.type === 'contact' ? 'contact' : item.action.type === 'share' ? 'share' : ''}}" data-action="{{item.action}}" bindtap="act"><image class="line-icon" src="{{item.icon}}" aria-hidden="true" /><text>{{item.label}}</text></button>
  </view>
  <view wx:elif="{{block.type === 'entries' && inCard}}" class="runtime-group">
    <text wx:if="{{block.title}}" class="section-title {{index ? 'tools-heading' : ''}}">{{block.title}}</text>
    <view class="service-grid"><button wx:for="{{block.items}}" wx:key="id" class="service-entry" open-type="{{item.action.type === 'contact' ? 'contact' : item.action.type === 'share' ? 'share' : ''}}" data-action="{{item.action}}" bindtap="act"><image class="line-icon" src="{{item.icon}}" aria-hidden="true" /><text>{{item.label}}</text><text wx:if="{{item.badge}}" class="runtime-entry-badge">{{item.badge}}</text></button></view>
  </view>
  <view wx:elif="{{block.type === 'entries'}}" class="surface runtime-block {{block.title ? 'services-card' : 'booking-shortcuts'}}">
    <text wx:if="{{block.title}}" class="section-title">{{block.title}}</text>
    <view wx:if="{{block.title}}" class="service-grid"><button wx:for="{{block.items}}" wx:key="id" class="service-entry" open-type="{{item.action.type === 'contact' ? 'contact' : item.action.type === 'share' ? 'share' : ''}}" data-action="{{item.action}}" bindtap="act"><image class="line-icon" src="{{item.icon}}" aria-hidden="true" /><text>{{item.label}}</text><text wx:if="{{item.badge}}" class="runtime-entry-badge">{{item.badge}}</text></button></view>
    <block wx:else><button wx:for="{{block.items}}" wx:key="id" open-type="{{item.action.type === 'contact' ? 'contact' : item.action.type === 'share' ? 'share' : ''}}" data-action="{{item.action}}" bindtap="act"><image class="line-icon" src="{{item.icon}}" aria-hidden="true" /><text>{{item.label}}</text></button></block>
  </view>
  <runtime-list wx:elif="{{block.type === 'list'}}" block="{{block}}" strings="{{strings}}" bindaction="forward" bindfacet="forwardFacet" bindsearch="forwardSearch" bindmore="forwardMore" />
  <runtime-calendar wx:elif="{{block.type === 'calendar'}}" block="{{block}}" strings="{{strings}}" bindaction="forward" bindweek="forwardWeek" />
  <runtime-participants wx:elif="{{block.type === 'participants'}}" class="{{block.style === 'tile' ? 'runtime-flex-item' : ''}}" block="{{block}}" strings="{{strings}}" bindaction="forward" bindparticipant="forwardParticipant" bindsheet="forwardSheet" />
  <view wx:elif="{{block.type === 'account'}}" class="account-header">
    <button class="account-identity" data-signed="{{block.signedIn}}" data-name="{{block.name}}" bindtap="account"><image class="account-avatar" src="/assets/account.png" aria-hidden="true" /><text class="account-name">{{block.signedIn ? block.name : block.prompt}}</text><view class="chevron"></view></button>
    <button wx:if="{{block.trailing}}" class="account-header-action" data-action="{{block.trailing.action}}" bindtap="act">{{block.trailing.label}}</button>
  </view>
  <screen-content wx:elif="{{block.type === 'content'}}" page-id="{{block.pageId}}" locale="{{locale}}" />
  <button wx:elif="{{block.type === 'button' && block.appearance === 'link'}}" class="text-button" open-type="{{block.action.type === 'contact' ? 'contact' : block.action.type === 'share' ? 'share' : ''}}" data-action="{{block.action}}" bindtap="act">{{block.label}}</button>
  <button wx:elif="{{block.type === 'button'}}" class="runtime-button appearance-{{block.appearance}} {{block.appearance === 'primary' ? 'primary' : ''}}" open-type="{{block.action.type === 'contact' ? 'contact' : block.action.type === 'share' ? 'share' : ''}}" data-action="{{block.action}}" bindtap="act">{{block.label}}</button>
  <view wx:elif="{{block.type === 'divider'}}" class="runtime-divider" />
  <view wx:elif="{{block.type === 'video'}}" class="runtime-media runtime-block"><text wx:if="{{block.title}}" class="section-title runtime-media-title">{{block.title}}</text><video class="runtime-video" src="{{block.src}}" poster="{{block.poster}}" controls show-center-play-btn object-fit="contain" /></view>
  <runtime-audio wx:elif="{{block.type === 'audio'}}" block="{{block}}" strings="{{strings}}" bindaction="forward" />
  <runtime-card wx:elif="{{block.type === 'card'}}" block="{{block}}" strings="{{strings}}" bindaction="forward" bindrefresh="forwardRefresh" />
  <view wx:elif="{{block.type === 'metrics'}}" class="surface runtime-block runtime-metrics">
    <text wx:if="{{block.title}}" class="section-title">{{block.title}}</text>
    <view wx:if="{{block.state === 'signedOut'}}" class="inline-signin"><text class="small muted">{{block.message}}</text><button class="primary" bindtap="login">{{strings.signIn}}</button></view>
    <view wx:else class="runtime-metric-grid columns-{{block.columns}}"><view wx:for="{{block.items}}" wx:key="label" class="runtime-metric"><view><text class="runtime-metric-value">{{item.value}}</text><text class="runtime-metric-unit">{{item.unit}}</text></view><text class="runtime-metric-label">{{item.label}}</text><text wx:if="{{item.hint}}" class="runtime-metric-hint">{{item.hint}}</text></view></view>
  </view>
  <view wx:elif="{{block.type === 'chart'}}" class="surface runtime-block runtime-chart">
    <text wx:if="{{block.title}}" class="section-title">{{block.title}}</text>
    <view wx:if="{{block.state === 'signedOut'}}" class="inline-signin"><text class="small muted">{{block.message}}</text><button class="primary" bindtap="login">{{strings.signIn}}</button></view>
    <block wx:else><image class="runtime-chart-image" src="{{block.image}}" mode="widthFix" data-image="{{block.image}}" bindtap="preview" />
      <view wx:if="{{block.legend.length}}" class="runtime-legend"><view wx:for="{{block.legend}}" wx:key="label" class="runtime-legend-item"><view class="runtime-legend-dot" style="background: {{item.color}}"></view><text>{{item.label}}</text></view></view>
      <text wx:if="{{block.caption}}" class="runtime-chart-caption">{{block.caption}}</text></block>
  </view>
  <view wx:elif="{{block.type === 'progress'}}" class="surface runtime-block runtime-progress">
    <text wx:if="{{block.title}}" class="section-title">{{block.title}}</text>
    <view wx:if="{{block.state === 'signedOut'}}" class="inline-signin"><text class="small muted">{{block.message}}</text><button class="primary" bindtap="login">{{strings.signIn}}</button></view>
    <block wx:else><view wx:for="{{block.items}}" wx:key="label" class="runtime-progress-row"><view class="runtime-progress-head"><text>{{item.label}}</text><text class="runtime-progress-caption">{{item.caption || item.percent + '%'}}</text></view><view class="runtime-bar-track"><view class="runtime-bar-fill" style="width: {{item.percent}}%"></view></view></view></block>
  </view>
  <view wx:elif="{{block.type === 'badges'}}" class="surface runtime-block runtime-badges">
    <text wx:if="{{block.title}}" class="section-title">{{block.title}}</text>
    <view wx:if="{{block.state === 'signedOut'}}" class="inline-signin"><text class="small muted">{{block.message}}</text><button class="primary" bindtap="login">{{strings.signIn}}</button></view>
    <view wx:else class="runtime-badge-grid columns-{{block.columns}}"><button wx:for="{{block.items}}" wx:key="id" class="runtime-badge {{item.earned ? 'earned' : ''}}" data-action="{{item.action}}" bindtap="act"><image src="{{item.image}}" mode="aspectFit" class="runtime-badge-image" /><text class="runtime-badge-label">{{item.label}}</text><text wx:if="{{item.caption}}" class="runtime-badge-caption">{{item.caption}}</text></button></view>
  </view>
  <view wx:elif="{{block.type === 'table'}}" class="surface runtime-block runtime-table-card">
    <text wx:if="{{block.title}}" class="section-title">{{block.title}}</text>
    <view wx:if="{{block.state === 'signedOut'}}" class="inline-signin"><text class="small muted">{{block.message}}</text><button class="primary" bindtap="login">{{strings.signIn}}</button></view>
    <scroll-view wx:else scroll-x class="runtime-table-scroll"><view class="runtime-table">
      <view class="runtime-table-row head"><text wx:for="{{block.columns}}" wx:key="*this" class="runtime-table-cell">{{item}}</text></view>
      <view wx:for="{{block.rows}}" wx:for-item="row" wx:for-index="rowIndex" wx:key="rowIndex" class="runtime-table-row"><text wx:for="{{row}}" wx:for-item="cell" wx:for-index="cellIndex" wx:key="cellIndex" class="runtime-table-cell" user-select>{{cell}}</text></view>
    </view></scroll-view>
  </view>
  <runtime-form wx:elif="{{block.type === 'form'}}" block="{{block}}" strings="{{strings}}" screen="{{screen}}" screen-params="{{screenParams}}" bindaction="forward" bindeffects="forwardEffects" />
  <block wx:elif="{{block.type === 'bar'}}"><view class="runtime-bar-space"></view><view class="runtime-bar {{lifted ? 'lifted' : ''}}">
    <button wx:for="{{block.buttons}}" wx:key="id" class="runtime-bar-button {{item.appearance}}" open-type="{{item.action.type === 'contact' ? 'contact' : item.action.type === 'share' ? 'share' : ''}}" data-action="{{item.action}}" bindtap="act">{{item.label}}</button>
  </view></block>
  <text wx:elif="{{block.fallback}}" class="runtime-text tone-muted">{{block.fallback}}</text>
</block>
</view>
