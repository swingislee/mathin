:host { display: block; width: 100%; }
.runtime-section.surface { padding: 30rpx 32rpx; }
.runtime-section.plain { padding: 0; }
.runtime-block { margin-bottom: 24rpx; }
/* Side-by-side sections reproduce the original account row: a 39% tile and a flexible companion. */
.layout-row { display: flex; align-items: stretch; gap: 22rpx; }
.layout-row > .runtime-flex-item { display: flex; flex: 1; min-width: 0; }
.runtime-tile { position: relative; overflow: hidden; flex: 0 0 39%; width: 39%; min-width: 0; margin: 0; text-align: left; padding: 28rpx 24rpx;
  background: linear-gradient(150deg, var(--primary-pale), var(--card)); min-height: 212rpx; }
.layout-column > .runtime-tile { width: 100%; margin-bottom: 24rpx; }
.runtime-group .service-grid { margin-bottom: 4rpx; }
.runtime-text { display: block; margin: 0 0 20rpx; font-size: 28rpx; line-height: 1.7; color: var(--ink); white-space: pre-wrap; }
.runtime-text.tone-muted { color: var(--muted); font-size: 25rpx; }
.runtime-text.tone-notice { padding: 20rpx 24rpx; border-radius: 16rpx; background: var(--primary-soft); color: var(--ink); }
.runtime-image { display: block; width: 100%; margin-bottom: 20rpx; border-radius: 20rpx; }
.runtime-image.fit-cover { height: 320rpx; }
.runtime-button { display: block; width: 100%; margin: 0 0 24rpx; }
.runtime-button.appearance-secondary { padding: 22rpx 0; border: 1rpx solid var(--line); border-radius: 999rpx; background: var(--card); color: var(--ink); font-size: 28rpx; text-align: center; }
.floating-services.lifted { bottom: calc(202rpx + env(safe-area-inset-bottom)); }
/* Original account shortcuts: four equal columns with the icon above the label. */
.booking-shortcuts button { display: flex; align-items: center; justify-content: center; flex-direction: column; flex: 0 0 25%; gap: 22rpx; width: 25%; margin: 0; padding: 0; text-align: center; font-size: 26rpx; font-weight: 500; }
.runtime-divider { height: 1rpx; margin: 12rpx 0 32rpx; background: var(--line); }
.service-entry { position: relative; }
.runtime-entry-badge { position: absolute; top: -6rpx; right: 18%; min-width: 32rpx; height: 32rpx; padding: 0 8rpx; box-sizing: border-box; border-radius: 16rpx; background: var(--rose); color: #fff; font-size: 20rpx; line-height: 32rpx; }

.runtime-tab-scroll { width: 100%; white-space: nowrap; margin-bottom: 20rpx; }
.runtime-tab-bar { display: inline-flex; gap: 12rpx; min-width: 100%; box-sizing: border-box; }
.runtime-tab-bar.style-segmented { padding: 6rpx; border-radius: 40rpx; background: var(--quiet); }
.runtime-tab { flex: 1; margin: 0; padding: 14rpx 28rpx; border-radius: 34rpx; font-size: 27rpx; color: var(--muted); background: none; white-space: nowrap; }
.style-segmented .runtime-tab.active { background: var(--card); color: var(--ink); font-weight: 600; box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, .06); }
.style-underline .runtime-tab { flex: none; border-radius: 0; padding: 14rpx 8rpx; }
.style-underline .runtime-tab.active { color: var(--primary); font-weight: 600; border-bottom: 4rpx solid var(--primary); }
.runtime-collapse { padding: 0 32rpx; }
.runtime-collapse.open { padding-bottom: 20rpx; }
.runtime-collapse-head { display: flex; align-items: center; justify-content: space-between; gap: 16rpx; width: 100%; margin: 0; padding: 28rpx 0; text-align: left; background: none; }
.runtime-collapse-copy { flex: 1; min-width: 0; display: flex; flex-direction: column; gap: 6rpx; }
.runtime-collapse-title { font-size: 30rpx; font-weight: 600; }
.runtime-collapse-summary { font-size: 24rpx; color: var(--muted); }
.runtime-collapse-head .chevron { width: 18rpx; height: 18rpx; color: var(--muted); }
.chevron.up { width: 12rpx; height: 12rpx; transform: rotate(-45deg); }
.runtime-media-title { margin-bottom: 16rpx; }
.runtime-video { display: block; width: 100%; height: 400rpx; border-radius: 20rpx; background: #000; }
.runtime-metrics, .runtime-chart, .runtime-progress, .runtime-badges, .runtime-table-card { padding: 30rpx 32rpx; }
.runtime-metric-grid { display: grid; gap: 20rpx; margin-top: 16rpx; }
.runtime-metric-grid.columns-2 { grid-template-columns: repeat(2, 1fr); }
.runtime-metric-grid.columns-3 { grid-template-columns: repeat(3, 1fr); }
.runtime-metric-grid.columns-4 { grid-template-columns: repeat(4, 1fr); }
.runtime-metric { display: flex; flex-direction: column; gap: 4rpx; padding: 18rpx; border-radius: 18rpx; background: var(--quiet); }
.runtime-metric-value { font-size: 40rpx; font-weight: 700; color: var(--primary); }
.runtime-metric-unit { margin-left: 4rpx; font-size: 22rpx; color: var(--muted); }
.runtime-metric-label { font-size: 23rpx; color: var(--ink); }
.runtime-metric-hint { font-size: 21rpx; color: var(--muted); }
.runtime-chart-image { display: block; width: 100%; margin-top: 16rpx; }
.runtime-legend { display: flex; flex-wrap: wrap; justify-content: center; gap: 12rpx 28rpx; margin-top: 12rpx; font-size: 23rpx; color: var(--muted); }
.runtime-legend-item { display: flex; align-items: center; gap: 8rpx; }
.runtime-legend-dot { width: 18rpx; height: 18rpx; border-radius: 9rpx; }
.runtime-chart-caption { display: block; margin-top: 16rpx; font-size: 25rpx; line-height: 1.7; color: var(--muted); white-space: pre-wrap; }
.runtime-progress-row { margin-top: 22rpx; }
.runtime-progress-head { display: flex; justify-content: space-between; font-size: 26rpx; }
.runtime-progress-caption { color: var(--muted); font-size: 24rpx; }
.runtime-bar-track { height: 16rpx; margin-top: 10rpx; border-radius: 8rpx; background: var(--quiet); overflow: hidden; }
.runtime-bar-fill { height: 100%; border-radius: 8rpx; background: var(--primary); }
.runtime-badge-grid { display: grid; gap: 20rpx 12rpx; margin-top: 20rpx; }
.runtime-badge-grid.columns-3 { grid-template-columns: repeat(3, 1fr); }
.runtime-badge-grid.columns-4 { grid-template-columns: repeat(4, 1fr); }
.runtime-badge-grid.columns-5 { grid-template-columns: repeat(5, 1fr); }
.runtime-badge { display: flex; flex-direction: column; align-items: center; gap: 6rpx; margin: 0; padding: 0; background: none; opacity: .38; filter: grayscale(1); }
.runtime-badge.earned { opacity: 1; filter: none; }
.runtime-badge-image { width: 96rpx; height: 96rpx; }
.runtime-badge-label { font-size: 23rpx; line-height: 1.3; text-align: center; }
.runtime-badge-caption { font-size: 20rpx; color: var(--muted); }
.runtime-table-scroll { width: 100%; margin-top: 16rpx; }
.runtime-table { display: table; min-width: 100%; border-collapse: collapse; font-size: 24rpx; }
.runtime-table-row { display: table-row; }
.runtime-table-row.head { font-weight: 600; background: var(--quiet); }
.runtime-table-cell { display: table-cell; padding: 14rpx 16rpx; border-bottom: 1rpx solid var(--line); white-space: nowrap; }
.runtime-bar-space { height: calc(150rpx + env(safe-area-inset-bottom)); }
.runtime-bar { position: fixed; z-index: 20; left: 0; right: 0; bottom: 0; display: flex; gap: 20rpx; padding: 18rpx 32rpx calc(18rpx + env(safe-area-inset-bottom));
  background: var(--card); border-top: 1rpx solid var(--line); }
.runtime-bar.lifted { bottom: calc(110rpx + env(safe-area-inset-bottom)); padding-bottom: 18rpx; }
.runtime-bar-button { flex: 1; margin: 0; min-height: 84rpx; line-height: 84rpx; padding: 0; border-radius: 42rpx; font-size: 29rpx; font-weight: 600; }
.runtime-bar-button.primary { background: var(--primary); color: #fff; }
.runtime-bar-button.secondary { background: var(--primary-soft); color: var(--primary); }
