<view class="surface week-card runtime-calendar">
  <view class="card-heading"><text class="section-title">{{block.title}}</text><button wx:if="{{block.more}}" class="text-link subtle" data-action="{{block.more.action}}" bindtap="act">{{block.more.label}}<view class="chevron"></view></button></view>
  <view wx:if="{{block.navigation}}" class="runtime-week-nav"><button class="week-step" bindtap="previous" aria-label="previous">‹</button><text>{{rangeLabel}}</text><button class="week-step" bindtap="next" aria-label="next">›</button></view>
  <date-grid mode="week" days="{{days}}" weekdays="{{weekdays}}" today-label="{{strings.today}}" bindselect="day" />
  <view wx:if="{{block.state === 'signedOut'}}" class="inline-signin"><button class="primary" bindtap="login">{{block.signInLabel || strings.signIn}}</button></view>
  <view wx:elif="{{block.state === 'error'}}" class="notice" role="alert">{{block.message}}</view>
  <empty-state wx:elif="{{!dayItems.length}}" label="{{block.empty}}" compact />
  <view wx:else class="schedule-list"><button wx:for="{{dayItems}}" wx:key="id" class="entry-card {{item.phase === 'ended' ? 'entry-ended' : ''}}" data-action="{{item.action}}" bindtap="act">
    <view class="entry-time"><text class="entry-status">{{item.status ? item.status.label : ''}}</text><text class="entry-start">{{item.start}}</text><text wx:if="{{item.end}}" class="entry-end">~{{item.end}}</text></view>
    <view class="entry-content"><text class="entry-title">{{item.title}}</text><text class="entry-meta">{{item.metaText}}</text><text wx:for="{{item.tags}}" wx:for-item="tag" wx:key="*this" class="entry-kind">{{tag}}</text></view>
  </button></view>
</view>
