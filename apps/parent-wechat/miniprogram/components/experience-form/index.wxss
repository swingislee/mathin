.form-group{margin:28rpx 0;padding-top:24rpx;border-top:1rpx solid var(--line,#dce0d7)}.group-title{display:block;font-weight:600;font-size:30rpx}.form-help{display:block;font-size:24rpx;color:var(--muted,#737c72);white-space:pre-wrap;line-height:1.7;margin-top:8rpx}.form-field{margin-top:26rpx}.field-label{display:block;font-size:28rpx;line-height:1.6;margin-bottom:10rpx}.required,.field-error{color:#a74444}.field-error{font-size:24rpx;display:block;margin-top:8rpx}.form-input{box-sizing:border-box;width:100%;min-height:80rpx;background:var(--card,#f4f5ef);border:1rpx solid var(--line,#dce0d7);border-radius:12rpx;padding:18rpx 20rpx;font-size:28rpx;line-height:1.6}.form-textarea{height:200rpx}.has-error .form-input{border-color:#a74444}.form-option{display:flex;align-items:center;gap:12rpx;font-size:28rpx;line-height:1.7;padding:10rpx 0}.entry-heading{display:flex;justify-content:space-between;align-items:center;font-size:26rpx;color:var(--muted,#737c72)}.form-entry{padding-bottom:20rpx}.add-entry,.text-button{font-size:26rpx;background:transparent;color:var(--primary,#587564)}.text-button{margin:0}.text-button::after{border:0}
