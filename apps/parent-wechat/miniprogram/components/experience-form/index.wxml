<view wx:for="{{groups}}" wx:for-item="group" wx:key="id" class="form-group"><text class="group-title">{{group.title}}</text><text class="form-help">{{group.description}}</text>
  <view wx:for="{{group.rows}}" wx:for-item="row" wx:key="index" class="form-entry"><view wx:if="{{group.repeat}}" class="entry-heading"><text>{{locale === 'en' ? 'Entry ' : '第 '}}{{row.index + 1}}{{locale === 'en' ? '' : ' 份'}}</text><button wx:if="{{group.canRemove}}" class="text-button" disabled="{{disabled}}" data-group="{{group.id}}" data-row="{{row.index}}" bindtap="remove">{{locale === 'en' ? 'Remove' : '移除'}}</button></view>
    <view wx:for="{{row.fields}}" wx:for-item="field" wx:key="id" class="form-field {{field.error ? 'has-error' : ''}}"><text class="field-label">{{field.label}}<text wx:if="{{field.required}}" class="required"> *</text></text>
      <textarea wx:if="{{field.type === 'textarea'}}" class="form-input form-textarea" value="{{field.value}}" maxlength="4000" placeholder="{{field.placeholder}}" disabled="{{disabled}}" data-group="{{group.id}}" data-row="{{row.index}}" data-field="{{field.id}}" bindinput="change" />
      <picker wx:elif="{{field.type === 'select'}}" range="{{field.options}}" range-key="label" value="{{field.selected}}" disabled="{{disabled}}" data-group="{{group.id}}" data-row="{{row.index}}" data-field="{{field.id}}" bindchange="change"><view class="form-input">{{field.options[field.selected].label}} ▾</view></picker>
      <picker wx:elif="{{field.type === 'date'}}" mode="date" value="{{field.value}}" disabled="{{disabled}}" data-group="{{group.id}}" data-row="{{row.index}}" data-field="{{field.id}}" bindchange="change"><view class="form-input">{{field.value || field.placeholder || (locale === 'en' ? 'Choose a date' : '选择日期')}}</view></picker>
      <checkbox-group wx:elif="{{field.type === 'multiselect'}}" data-group="{{group.id}}" data-row="{{row.index}}" data-field="{{field.id}}" bindchange="change"><label wx:for="{{field.options}}" wx:key="id" wx:if="{{item.id}}" class="form-option"><checkbox value="{{item.id}}" checked="{{item.checked}}" disabled="{{disabled}}" /><text>{{item.label}}</text></label></checkbox-group>
      <checkbox-group wx:elif="{{field.type === 'consent'}}" data-group="{{group.id}}" data-row="{{row.index}}" data-field="{{field.id}}" bindchange="change"><label class="form-option"><checkbox value="yes" checked="{{field.value === 'yes'}}" disabled="{{disabled}}" /><text>{{locale === 'en' ? 'I confirm' : '我已确认'}}</text></label></checkbox-group>
      <input wx:else class="form-input" value="{{field.value}}" maxlength="500" placeholder="{{field.placeholder}}" disabled="{{disabled}}" data-group="{{group.id}}" data-row="{{row.index}}" data-field="{{field.id}}" bindinput="change" />
      <text wx:if="{{field.help}}" class="form-help">{{field.help}}</text><text wx:if="{{field.error}}" class="field-error">{{locale === 'en' ? 'Check this answer' : '请核对这一项'}}</text>
    </view>
  </view><button wx:if="{{group.repeat && group.canAdd}}" class="add-entry" disabled="{{disabled}}" data-group="{{group.id}}" bindtap="add">+ {{locale === 'en' ? 'Add another entry' : '再填一份'}}</button>
</view>
