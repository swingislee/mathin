<view wx:for="{{groups}}" wx:for-item="group" wx:key="id" class="form-group"><text class="group-title">{{group.title}}</text><text class="form-help">{{group.description}}</text>
  <view wx:for="{{group.rows}}" wx:for-item="row" wx:key="index" class="form-entry"><view wx:if="{{group.repeat}}" class="entry-heading"><text>{{locale === 'en' ? 'Entry ' : '第 '}}{{row.index + 1}}{{locale === 'en' ? '' : ' 份'}}</text><button wx:if="{{group.canRemove}}" class="text-button" disabled="{{disabled}}" data-group="{{group.id}}" data-row="{{row.index}}" bindtap="remove">{{locale === 'en' ? 'Remove' : '移除'}}</button></view>
    <runtime-field wx:for="{{row.fields}}" wx:for-item="cell" wx:key="key" field="{{cell.field}}" value="{{cell.value}}" error="{{cell.error}}" disabled="{{disabled}}" strings="{{strings}}"
      data-group="{{group.id}}" data-row="{{row.index}}" data-field="{{cell.key}}" bindchange="change" />
  </view><button wx:if="{{group.repeat && group.canAdd}}" class="add-entry" disabled="{{disabled}}" data-group="{{group.id}}" bindtap="add">+ {{locale === 'en' ? 'Add another entry' : '再填一份'}}</button>
</view>
