:host{display:block;min-width:0}.participant-label{display:block;font-size:26rpx;font-weight:600;margin:12rpx 0}.participant-option{display:flex;align-items:center;gap:16rpx;min-height:76rpx;padding:14rpx 0;background:transparent;color:var(--ink);font-size:28rpx;text-align:left;border-radius:0;line-height:1.5}.participant-option::after{border:0}.avatar{width:60rpx;height:60rpx;flex:none}.identity{flex:1;min-width:0;overflow-wrap:anywhere}.subtitle{display:block;font-size:24rpx;color:var(--muted);margin-top:4rpx}.chevron,.check{margin-left:auto;color:var(--muted)}.selected{color:var(--primary)}
