<text wx:if="{{label}}" class="participant-label">{{label}}</text>
<checkbox-group wx:if="{{multiple}}" bindchange="check"><label wx:for="{{options}}" wx:key="id" class="participant-option"><checkbox value="{{item.id}}" checked="{{item.checked}}" disabled="{{disabled}}" /><text>{{item.name}}</text></label></checkbox-group>
<view wx:elif="{{mode === 'list'}}"><button wx:for="{{rows}}" wx:key="id" class="participant-option {{index === selected ? 'selected' : ''}}" data-index="{{index}}" bindtap="choose" disabled="{{disabled}}"><image src="/assets/participant.png" class="avatar" aria-hidden="true" /><text>{{item.name}}</text><text wx:if="{{index === selected}}" class="check">✓</text></button></view>
<picker wx:elif="{{rows.length}}" range="{{rows}}" range-key="name" value="{{selected}}" bindchange="pick" disabled="{{disabled}}"><view class="participant-option"><image src="/assets/participant.png" class="avatar" aria-hidden="true" /><view class="identity"><text>{{rows[selected].name || placeholder}}</text><text wx:if="{{subtitle}}" class="subtitle">{{subtitle}}</text></view><text class="chevron">▾</text></view></picker>
<button wx:else class="participant-option" bindtap="empty" disabled="{{disabled}}"><image src="/assets/participant.png" class="avatar" aria-hidden="true" /><text>{{placeholder}}</text></button>
