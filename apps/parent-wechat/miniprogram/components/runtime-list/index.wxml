<view class="{{block.template === 'carousel' || block.template === 'tile' ? 'runtime-list-plain' : 'surface'}} runtime-list template-{{block.template}}">
  <view wx:if="{{block.title || block.more}}" class="card-heading"><text class="section-title">{{block.title}}</text><button wx:if="{{block.more}}" class="text-link" data-action="{{block.more.action}}" bindtap="act">{{block.more.label}}<view class="chevron"></view></button></view>
  <view wx:if="{{search}}" class="runtime-search"><input class="runtime-search-input" value="{{query}}" placeholder="{{search.hint || search.label}}" confirm-type="search" bindinput="type" bindconfirm="find" /><button wx:if="{{query}}" class="runtime-search-clear" bindtap="clearSearch" aria-label="clear">×</button><button class="runtime-search-go" bindtap="find">{{strings.search}}</button></view>
  <view wx:if="{{choices.length}}" class="discovery-filters runtime-facets"><button wx:for="{{choices}}" wx:key="id" class="filter-pill {{item.value ? 'selected' : ''}}" data-facet="{{item.id}}" bindtap="facet"><text>{{item.value ? item.valueLabel : item.label}}</text><view class="chevron down"></view></button></view>
  <view wx:if="{{block.state === 'signedOut'}}" class="inline-signin runtime-signin"><text class="small muted">{{block.message}}</text><button class="primary" bindtap="login">{{strings.signIn}}</button></view>
  <view wx:elif="{{block.state === 'error'}}" class="notice" role="alert">{{block.message}}</view>
  <empty-state wx:elif="{{!rows.length}}" label="{{block.empty}}" compact="{{block.template !== 'card'}}" />
  <block wx:elif="{{block.template === 'card'}}"><button wx:for="{{rows}}" wx:key="id" class="activity-row" data-action="{{item.action}}" bindtap="act" hover-class="pressed">
    <view class="activity-tile"><image wx:if="{{item.image}}" src="{{item.image}}" class="activity-tile-cover" mode="aspectFill" lazy-load /><image wx:else src="/assets/icons/activity.png" class="activity-tile-icon" aria-hidden="true" /></view>
    <view class="activity-row-content"><text class="activity-row-title">{{item.title}}</text><text wx:if="{{item.summary}}" class="activity-row-summary">{{item.summary}}</text><text wx:if="{{item.metaText}}" class="activity-row-meta">{{item.metaText}}</text><view wx:if="{{item.tags.length}}" class="activity-labels"><text wx:for="{{item.tags}}" wx:for-item="label" wx:key="*this" class="small-pill">{{label}}</text></view><view class="activity-row-bottom"><text class="activity-price">{{item.status ? item.status.label : ''}}</text><text wx:if="{{item.actionLabel}}" class="small-pill">{{item.actionLabel}}</text></view></view>
  </button></block>
  <view wx:elif="{{block.template === 'timeline'}}" class="runtime-timeline"><button wx:for="{{rows}}" wx:key="id" class="runtime-timeline-row" data-action="{{item.action}}" bindtap="act" hover-class="pressed">
    <view class="runtime-timeline-date"><text>{{item.date}}</text><text wx:if="{{item.start}}" class="runtime-timeline-time">{{item.start}}</text></view>
    <view class="runtime-timeline-dot {{item.status ? 'tone-' + item.status.tone : ''}}"></view>
    <view class="runtime-row-main"><text class="runtime-row-title">{{item.title}}</text><text wx:if="{{item.subtitle}}" class="runtime-row-subtitle">{{item.subtitle}}</text><text wx:if="{{item.summary}}" class="runtime-row-summary">{{item.summary}}</text>
      <view wx:if="{{item.images.length}}" class="runtime-thumbs"><image wx:for="{{item.images}}" wx:for-item="src" wx:key="*this" src="{{src}}" mode="aspectFill" data-images="{{item.images}}" data-current="{{src}}" catchtap="preview" lazy-load /></view>
      <view class="runtime-row-foot"><text wx:if="{{item.status}}" class="runtime-status tone-{{item.status.tone}}">{{item.status.label}}</text><text wx:if="{{item.stamp}}" class="runtime-stamp">{{item.stamp}}</text></view></view>
  </button></view>
  <view wx:elif="{{block.template === 'message'}}" class="runtime-messages"><view wx:for="{{rows}}" wx:key="id" class="runtime-message side-{{item.side || 'start'}}" data-action="{{item.action}}" bindtap="act">
    <image wx:if="{{item.avatar}}" class="runtime-message-avatar" src="{{item.avatar}}" mode="aspectFill" />
    <view class="runtime-bubble"><text wx:if="{{item.title}}" class="runtime-bubble-title">{{item.title}}</text><text wx:if="{{item.summary}}" class="runtime-bubble-text" user-select>{{item.summary}}</text>
      <view wx:if="{{item.images.length}}" class="runtime-thumbs"><image wx:for="{{item.images}}" wx:for-item="src" wx:key="*this" src="{{src}}" mode="aspectFill" data-images="{{item.images}}" data-current="{{src}}" catchtap="preview" lazy-load /></view>
      <text class="runtime-bubble-meta">{{item.subtitle}}{{item.status ? ' · ' + item.status.label : ''}}</text></view>
  </view></view>
  <scroll-view wx:elif="{{block.template === 'carousel'}}" scroll-x class="runtime-carousel-scroll" enhanced show-scrollbar="{{false}}"><view class="runtime-carousel-track">
    <button wx:for="{{rows}}" wx:key="id" class="runtime-tile-card runtime-carousel-card surface" data-action="{{item.action}}" bindtap="act"><image wx:if="{{item.image}}" src="{{item.image}}" class="runtime-tile-image" mode="aspectFill" lazy-load /><text wx:if="{{item.badge}}" class="runtime-tile-badge">{{item.badge}}</text><text class="runtime-tile-title">{{item.title}}</text><text wx:if="{{item.subtitle || item.metaText}}" class="runtime-tile-meta">{{item.subtitle || item.metaText}}</text></button>
  </view></scroll-view>
  <view wx:elif="{{block.template === 'tile'}}" class="runtime-tiles"><button wx:for="{{rows}}" wx:key="id" class="runtime-tile-card surface" data-action="{{item.action}}" bindtap="act"><image wx:if="{{item.image}}" src="{{item.image}}" class="runtime-tile-image" mode="aspectFill" lazy-load /><text wx:if="{{item.badge}}" class="runtime-tile-badge">{{item.badge}}</text><text class="runtime-tile-title">{{item.title}}</text><text wx:if="{{item.subtitle || item.metaText}}" class="runtime-tile-meta">{{item.subtitle || item.metaText}}</text>
    <view wx:if="{{item.progress >= 0}}" class="runtime-bar-track"><view class="runtime-bar-fill" style="width: {{item.progress}}%"></view></view></button></view>
  <block wx:else><button wx:for="{{rows}}" wx:key="id" class="runtime-row" data-action="{{item.action}}" bindtap="act" hover-class="pressed">
    <image wx:if="{{item.avatar}}" class="runtime-row-avatar" src="{{item.avatar}}" mode="aspectFill" />
    <view class="runtime-row-main"><text class="runtime-row-title">{{item.title}}</text><text wx:if="{{item.subtitle}}" class="runtime-row-subtitle">{{item.subtitle}}</text><text wx:if="{{item.metaText}}" class="runtime-row-meta">{{item.metaText}}</text><text wx:if="{{item.summary}}" class="runtime-row-summary">{{item.summary}}</text>
      <view wx:if="{{item.progress >= 0}}" class="runtime-bar-track"><view class="runtime-bar-fill" style="width: {{item.progress}}%"></view></view></view>
    <text wx:if="{{item.badge}}" class="runtime-count">{{item.badge}}</text>
    <text wx:if="{{item.status}}" class="runtime-status tone-{{item.status.tone}}">{{item.status.label}}</text>
    <view wx:if="{{item.action}}" class="chevron"></view>
  </button></block>
  <button wx:if="{{block.next && rows.length}}" class="text-button runtime-more" bindtap="more">{{strings.more}}</button>
</view>
