<view wx:if="{{mode === 'matrix'}}" class="slot-table"><view class="slot-week-label">{{weekLabel}}</view><view class="slot-table-row slot-table-header"><view class="slot-date-heading">{{labels.assessmentDate}}</view><view wx:for="{{days}}" wx:key="date" class="slot-table-cell"><text class="slot-day">{{item.label}}</text><text class="slot-weekday">{{item.weekday}}</text></view></view><view wx:for="{{timeRows}}" wx:for-item="row" wx:key="key" class="slot-table-row"><view class="slot-period">{{row.period}}</view><view class="slot-time-heading"><text>{{row.start}}</text><text>~{{row.end}}</text></view><view wx:for="{{row.cells}}" wx:for-item="cell" wx:key="key" class="slot-table-cell"><button class="slot-option {{cell.selected ? 'selected' : ''}}" data-id="{{cell.id}}" bindtap="select" disabled="{{disabled || !cell.available}}" aria-label="{{cell.available ? labels.availableSlot : labels.unavailableSlot}}">{{cell.selected ? '✓' : (cell.available ? labels.availableSlot : '')}}</button></view></view></view>
<view wx:else class="slot-options"><button wx:for="{{rows}}" wx:key="id" class="time-option {{item.selected ? 'chosen' : ''}}" data-id="{{item.id}}" bindtap="select" disabled="{{disabled || item.available === false}}">{{item.label}}</button></view>
