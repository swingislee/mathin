.content-document{font-size:28rpx;line-height:1.75;color:var(--ink,#243028)}.content-block{margin:0 0 28rpx}.content-title{display:block;font-size:32rpx;font-weight:600;margin-bottom:14rpx;line-height:1.5}.kind-heading .level-2{font-size:40rpx}.kind-paragraph{white-space:pre-wrap}.kind-callout,.kind-quote{padding:24rpx;border-radius:18rpx;background:var(--card,#f2f3ed)}.kind-quote{border-left:5rpx solid var(--primary,#587564)}.tone-notice{background:#faf0d9;color:#745823}.content-image{display:block;width:100%;border-radius:16rpx}.kind-image .content-image[mode=aspectFill]{height:360rpx}.caption{display:block;font-size:24rpx;line-height:1.6;color:var(--muted,#757b73);white-space:pre-wrap}.content-item{display:flex;gap:16rpx;margin:14rpx 0}.item-copy{flex:1;min-width:0}.item-title{display:block;font-weight:600}.step-number{width:44rpx;height:44rpx;border-radius:50%;background:var(--primary,#587564);color:#fff;text-align:center;flex-shrink:0}.content-action{border-radius:16rpx;font-size:28rpx;background:var(--primary,#587564);color:#fff;white-space:normal;line-height:1.5;padding:22rpx}.appearance-secondary{background:var(--card,#f0f2ed);color:var(--ink,#243028)}.appearance-link{background:transparent;color:var(--primary,#587564);padding:8rpx}.faq-question{padding:10rpx 0;background:transparent;text-align:left;display:flex;justify-content:space-between;gap:20rpx;font-size:28rpx;line-height:1.6;font-weight:600}.faq-question::after,.content-card::after,.content-action::after{border:0}.kind-divider{height:1rpx;background:var(--line,#dce0d7);margin:36rpx 0}.table-row{display:flex;border-bottom:1rpx solid var(--line,#dce0d7)}.table-row text{padding:14rpx;flex:1;min-width:160rpx;white-space:pre-wrap}.content-table{min-width:100%;width:max-content;font-size:25rpx}.table-header{font-weight:600;background:var(--card,#f1f3ed)}.metric{font-size:48rpx;font-weight:600;display:flex;gap:10rpx;align-items:baseline}.scale-labels{display:flex;justify-content:space-between;font-size:22rpx;border-top:8rpx solid var(--primary,#587564);padding-top:12rpx}.content-card{display:flex;gap:20rpx;background:var(--card,#f1f3ed);border-radius:18rpx;padding:22rpx;margin-bottom:14rpx;text-align:left;font-size:28rpx;line-height:1.6}.content-card image{width:120rpx;height:120rpx;flex-shrink:0;border-radius:12rpx}.layout-grid{display:grid;grid-template-columns:1fr 1fr;gap:14rpx}.layout-grid .content-card{display:block}.layout-grid .content-card image{width:100%;height:160rpx}

.document-sections .content-block{padding:24rpx;border-bottom:1rpx solid var(--line,#dce0d7)}.document-sections .kind-heading{border-bottom:0;padding-bottom:0}
.report-chart{margin:20rpx 0}.chart-image{display:block;width:100%;max-width:600rpx;margin:auto}.chart-measure{margin:18rpx 0}.chart-label{display:flex;justify-content:space-between;gap:20rpx;font-size:24rpx}.chart-label text:first-child{min-width:0;word-break:break-all}.chart-label text:last-child{flex-shrink:0}.chart-track{height:14rpx;border-radius:8rpx;background:var(--line,#dce0d7);margin-top:10rpx;overflow:hidden}.chart-fill{height:100%;border-radius:8rpx;background:var(--primary,#6f8b48)}
