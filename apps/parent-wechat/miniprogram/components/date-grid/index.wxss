.date-grid{display:grid;grid-template-columns:repeat(7,minmax(0,1fr));gap:8rpx;padding:12rpx 0}.weekday{text-align:center;font-size:23rpx;color:var(--muted);line-height:1.6}.day{display:flex;flex-direction:column;align-items:center;justify-content:center;position:relative;min-height:72rpx;width:100%;padding:8rpx 0;background:transparent;color:var(--ink);border-radius:18rpx;font-size:26rpx;line-height:1.6}.day::after{border:0}.day[disabled]{opacity:.25}.day.selected{background:var(--moon);color:var(--ink)}.day-number{min-height:40rpx}.dot{width:7rpx;height:7rpx;border-radius:50%;background:var(--primary);position:absolute;bottom:5rpx}.mode-week .day{min-height:98rpx}
