<view class="date-grid mode-{{mode}}"><text wx:if="{{mode === 'month'}}" wx:for="{{headers}}" wx:key="key" class="weekday">{{item.label}}</text><button wx:for="{{dates}}" wx:key="key" class="day {{item.selected ? 'selected' : ''}} {{item.today ? 'today' : ''}}" data-date="{{item.date}}" bindtap="choose" disabled="{{disabled || !item.date}}" aria-label="{{item.date}} · {{item.count || 0}}"><text wx:if="{{mode === 'week'}}" class="weekday">{{item.weekdayText}}</text><text class="day-number">{{item.today ? todayLabel : item.day}}</text><view wx:if="{{item.count}}" class="dot" /></button></view>
