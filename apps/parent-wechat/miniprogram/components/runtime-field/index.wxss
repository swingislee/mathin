.rf { margin-top: 28rpx; }
.rf-label { display: block; margin-bottom: 12rpx; font-size: 28rpx; line-height: 1.6; color: var(--ink); }
.rf-required, .rf-error .rf-label { color: var(--rose); }
.rf-input { display: flex; align-items: center; justify-content: space-between; box-sizing: border-box; width: 100%; min-height: 84rpx; padding: 18rpx 22rpx;
  border: 1rpx solid var(--line); border-radius: 16rpx; background: var(--quiet, #f6f4ee); color: var(--ink); font-size: 28rpx; line-height: 1.6; text-align: left; margin: 0; }
.rf-error .rf-input { border-color: var(--rose); }
.rf-textarea { display: block; min-height: 180rpx; }
.rf-placeholder { color: var(--muted); }
.rf-picker .chevron { width: 16rpx; height: 16rpx; color: var(--muted); }
.rf-address text { flex: 1; min-width: 0; }
.rf-options { display: flex; flex-wrap: wrap; gap: 16rpx; }
.rf-option { display: flex; flex-direction: column; align-items: center; justify-content: center; position: relative; box-sizing: border-box; min-width: calc((100% - 32rpx) / 3);
  min-height: 72rpx; margin: 0; padding: 12rpx 18rpx; border: 2rpx solid var(--line); border-radius: 40rpx; background: var(--card); font-size: 26rpx; line-height: 1.4; }
.rf-list .rf-option { width: 100%; align-items: flex-start; border-radius: 16rpx; }
.rf-option.selected { color: var(--primary); border-color: var(--primary); background: var(--primary-soft); }
.rf-option.rf-disabled { opacity: .45; }
.rf-hint { font-size: 22rpx; color: var(--muted); }
.rf-badge { position: absolute; top: -14rpx; right: -6rpx; padding: 2rpx 10rpx; border-radius: 20rpx; background: var(--rose); color: #fff; font-size: 20rpx; }
.rf-rating { display: flex; gap: 10rpx; }
.rf-star { margin: 0; padding: 0 6rpx; font-size: 52rpx; line-height: 1.2; color: var(--line); background: none; }
.rf-star.on { color: #e3a83a; }
.rf-media { display: flex; flex-wrap: wrap; gap: 16rpx; }
.rf-media-item { position: relative; width: calc((100% - 32rpx) / 3); height: 200rpx; margin: 0; padding: 0; border-radius: 16rpx; overflow: hidden; background: var(--quiet, #f6f4ee); }
.rf-media-item image { display: block; width: 100%; height: 100%; }
.rf-file { display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 8rpx; height: 100%; padding: 12rpx; box-sizing: border-box; color: var(--muted); font-size: 30rpx; }
.rf-file-name { width: 100%; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; font-size: 20rpx; text-align: center; }
.rf-remove { position: absolute; top: 6rpx; right: 6rpx; width: 44rpx; height: 44rpx; min-height: 0; margin: 0; padding: 0; line-height: 44rpx; border-radius: 22rpx; background: rgba(0, 0, 0, .45); color: #fff; font-size: 28rpx; }
.rf-uploading .rf-progress { position: absolute; inset: 0; display: flex; align-items: center; justify-content: center; background: rgba(255, 255, 255, .7); font-size: 22rpx; color: var(--muted); }
.rf-add { display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 6rpx; border: 2rpx dashed var(--line); color: var(--muted); font-size: 24rpx; }
.rf-plus { font-size: 44rpx; line-height: 1; }
.rf-check { display: flex; align-items: center; gap: 12rpx; font-size: 27rpx; line-height: 1.7; }
.rf-help { display: block; margin-top: 10rpx; font-size: 23rpx; line-height: 1.7; color: var(--muted); white-space: pre-wrap; }
