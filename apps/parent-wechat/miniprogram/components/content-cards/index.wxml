<view class="cards layout-{{layout}} density-{{density}}"><button wx:for="{{rows}}" wx:key="id" class="content-card" data-id="{{item.id}}" bindtap="select"><image wx:if="{{item.image}}" src="{{item.image}}" mode="aspectFill" lazy-load /><view class="card-copy"><text class="item-title">{{item.title}}</text><text wx:if="{{item.text}}" class="caption">{{item.text}}</text><text wx:if="{{item.meta}}" class="caption">{{item.meta}}</text></view><text class="arrow">›</text></button></view>
