.content-card{display:flex;align-items:center;gap:20rpx;max-width:100%;background:var(--card,#f1f3ed);border-radius:18rpx;padding:24rpx;margin:0 0 18rpx;text-align:left;font-size:28rpx;line-height:1.6;white-space:normal;color:var(--ink,#243028)}.content-card::after{border:0}.content-card image{width:130rpx;height:130rpx;flex-shrink:0;border-radius:12rpx}.card-copy{min-width:0;flex:1}.item-title{display:block;font-weight:600;overflow-wrap:break-word}.caption{display:block;font-size:24rpx;line-height:1.6;color:var(--muted,#757b73);margin-top:8rpx}.arrow{flex-shrink:0;color:var(--muted,#757b73)}.layout-grid{display:grid;grid-template-columns:minmax(0,1fr) minmax(0,1fr);gap:14rpx}.layout-grid .content-card{display:block;width:100%;box-sizing:border-box}.layout-grid .content-card image{width:100%;height:160rpx}.layout-grid .arrow{display:none}

.density-compact .activity-row,.density-compact .content-card{padding-top:12rpx;padding-bottom:12rpx;margin-bottom:8rpx}.density-compact .activity-tile{width:100rpx;height:110rpx}.density-compact .content-card image{width:90rpx;height:90rpx}
