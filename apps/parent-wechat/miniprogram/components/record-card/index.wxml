<view class="record density-{{density}}"><button wx:if="{{interactive}}" class="record-heading" bindtap="select" aria-expanded="{{expanded}}"><view class="record-title"><text>{{heading}}</text><text class="record-status">{{status}}</text></view><text wx:if="{{subtitle}}" class="record-meta">{{subtitle}}</text><text class="record-arrow">{{expanded ? '−' : '›'}}</text></button><view wx:else class="record-heading"><view class="record-title"><text>{{heading}}</text><text wx:if="{{status}}" class="record-status">{{status}}</text></view><text wx:if="{{subtitle}}" class="record-meta">{{subtitle}}</text></view><text wx:if="{{participant}}" class="record-person">{{participant}}</text><text wx:if="{{note}}" class="record-note">{{note}}</text><slot /></view>
