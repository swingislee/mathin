:host{display:block;min-width:0}.record{padding:28rpx;margin:20rpx 0;background:var(--card);border-radius:22rpx;min-width:0}.record-heading{display:block;position:relative;line-height:1.6;color:var(--ink);background:transparent;padding:0;margin:0;text-align:left;border-radius:0;font-size:28rpx;overflow-wrap:anywhere}.record-heading::after{border:0}.record-title{display:flex;align-items:flex-start;justify-content:space-between;gap:16rpx;padding-right:20rpx;font-weight:600}.record-status{font-size:23rpx;color:var(--muted);font-weight:400;flex-shrink:0;max-width:45%}.record-meta,.record-person{display:block;font-size:24rpx;color:var(--muted);margin-top:8rpx}.record-note{display:block;white-space:pre-wrap;overflow-wrap:anywhere;font-size:27rpx;line-height:1.7;margin-top:12rpx}.record-arrow{position:absolute;right:0;top:0;color:var(--muted)}.density-compact{padding:16rpx 20rpx;margin:10rpx 0}
