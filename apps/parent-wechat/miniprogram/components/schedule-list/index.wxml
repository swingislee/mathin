<view class="schedule-list density-{{density}}"><view wx:for="{{rows}}" wx:key="key" class="entry-card {{item.phase === 'ended' ? 'entry-ended' : ''}}"><view class="entry-time"><text class="entry-status">{{labels[item.phase]}}</text><text class="entry-start">{{item.startTime}}</text><text wx:if="{{item.endTime}}" class="entry-end">~{{item.endTime}}</text></view><view class="entry-content"><text class="entry-title">{{item.title}}</text><text class="entry-meta">{{item.detail || (item.kind === 'activity' ? labels.locationPending : '')}}{{item.facilitator ? ' | ' + item.facilitator : ''}}</text><text wx:if="{{item.kind === 'activity'}}" class="entry-kind">{{labels.activityArrangement}}</text></view></view></view>
