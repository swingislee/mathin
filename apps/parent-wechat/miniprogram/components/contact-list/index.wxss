.contact{padding:28rpx;background:var(--card);border-radius:22rpx;margin:20rpx 0;line-height:1.7;overflow-wrap:anywhere}.contact-name{display:block;font-size:32rpx;font-weight:600}.contact-line{display:block;font-size:27rpx;margin-top:8rpx;white-space:pre-wrap}.contact-caption{display:block;font-size:23rpx;color:var(--muted)}.contact-qr{display:block;width:280rpx;height:280rpx;margin:20rpx auto}.contact-call{font-size:28rpx;background:var(--primary);color:var(--paper);margin-top:20rpx;border-radius:16rpx;padding:12rpx;line-height:1.6}.contact-call::after{border:0}.density-compact{padding:16rpx 20rpx;margin:10rpx 0}.density-compact .contact-qr{width:200rpx;height:200rpx;margin:12rpx auto}
