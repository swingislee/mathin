<view wx:for="{{rows}}" wx:key="id" class="contact density-{{density}}"><text class="contact-name">{{item.name || (locale === 'en' ? 'Service contact' : '服务人员')}}</text><text wx:if="{{item.service}}" class="contact-line">{{item.service}}</text><text wx:if="{{item.campus}}" class="contact-caption">{{item.campus}}</text><image wx:if="{{item.qrImage}}" class="contact-qr" src="{{item.qrImage}}" mode="aspectFit" show-menu-by-longpress bindtap="preview" data-id="{{item.id}}" /><text wx:if="{{item.qrImage}}" class="contact-caption">{{locale === 'en' ? 'Long press to add this contact on WeChat' : '长按二维码添加服务人员微信'}}</text><text wx:if="{{item.hours}}" class="contact-line">{{locale === 'en' ? 'Hours' : '服务时间'}} · {{item.hours}}</text><text wx:if="{{item.address}}" class="contact-line">{{locale === 'en' ? 'Address' : '服务地址'}} · {{item.address}}</text><text wx:if="{{item.phone}}" class="contact-line">{{item.phone}}</text><button wx:if="{{item.phone}}" class="contact-call" bindtap="phone" data-id="{{item.id}}">{{locale === 'en' ? 'Call service' : '拨打电话'}}</button></view>
