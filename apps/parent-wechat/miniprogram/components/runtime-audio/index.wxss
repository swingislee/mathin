.runtime-audio { margin-bottom: 24rpx; padding: 30rpx 32rpx 24rpx; }
.runtime-track { display: flex; align-items: center; gap: 20rpx; width: 100%; margin: 0; padding: 22rpx 0; border-bottom: 1rpx solid var(--quiet); background: none; text-align: left; }
.runtime-track-mark { flex-shrink: 0; display: flex; align-items: center; justify-content: center; width: 56rpx; height: 56rpx; border-radius: 28rpx; background: var(--primary-soft); color: var(--primary); text-align: center; font-size: 22rpx; }
.runtime-track.current .runtime-track-mark { background: var(--primary); color: #fff; }
.runtime-track-copy { flex: 1; min-width: 0; display: flex; flex-direction: column; gap: 4rpx; }
.runtime-track-title { font-size: 28rpx; font-weight: 600; }
.runtime-track.current .runtime-track-title { color: var(--primary); }
.runtime-track-subtitle { font-size: 23rpx; color: var(--muted); }
.runtime-audio-controls { display: flex; align-items: center; justify-content: center; gap: 48rpx; padding-top: 20rpx; }
.runtime-audio-step { margin: 0; padding: 0 12rpx; font-size: 34rpx; color: var(--muted); background: none; }
.runtime-audio-main { display: flex; align-items: center; justify-content: center; width: 96rpx; height: 96rpx; margin: 0; padding: 0; border-radius: 48rpx; background: var(--primary); color: #fff; font-size: 30rpx; }
