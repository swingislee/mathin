<view wx:if="{{!hidden}}" class="runtime-tab-bar presentation-{{presentation}}" role="tablist">
  <button wx:for="{{tabs}}" wx:key="slot" class="runtime-tab {{selected === item.slot ? 'selected' : ''}}" data-slot="{{item.slot}}" bindtap="open" role="tab" aria-selected="{{selected === item.slot}}">
    <view class="runtime-tab-content"><image class="runtime-tab-icon" src="{{selected === item.slot ? item.activeUrl : item.iconUrl}}" aria-hidden="true" />
    <text>{{item.label}}</text></view>
  </button>
</view>
