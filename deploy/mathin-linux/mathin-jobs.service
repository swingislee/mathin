[Unit]
Description=Mathin durable job worker
After=network-online.target mathin.service
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/home/swing/services/mathin/current
EnvironmentFile=/home/swing/services/mathin/config/.env.production.local
Environment=NODE_ENV=production
Environment=R1_JOB_WORKER_ID=xiaomi-production-1
ExecStart=/home/swing/.local/bin/node /home/swing/services/mathin/current/scripts/r1-job-worker.mjs
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only

[Install]
WantedBy=default.target
