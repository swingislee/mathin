diff --git a/dist/events-583399dd.cjs.prod.js b/dist/events-583399dd.cjs.prod.js
index 3376d706b8390ba33b9360ce93a8e54b764edae5..f6567438e8a88c3f6aa76050e3c645166cfc313f 100644
--- a/dist/events-583399dd.cjs.prod.js
+++ b/dist/events-583399dd.cjs.prod.js
@@ -1038,7 +1038,38 @@ const createStore = (invalidate, advance) => {
       linear: false,
       flat: false,
       controls: null,
-      clock: new THREE__namespace.Clock(),
+      // 使用 Timer 计时，保留 R3F 9 的自动启动、停表与手动帧时钟合同。
+      clock: new (class extends THREE__namespace.Timer {
+        autoStart = true;
+        running = false;
+        startTime = 0;
+        oldTime = 0;
+        elapsedTime = 0;
+        start() {
+          this.reset();
+          this.startTime = this.oldTime = performance.now();
+          this.elapsedTime = 0;
+          this.running = true;
+        }
+        stop() {
+          this.getElapsedTime();
+          this.running = false;
+          this.autoStart = false;
+        }
+        getElapsedTime() {
+          this.getDelta();
+          return this.elapsedTime;
+        }
+        getDelta() {
+          if (this.autoStart && !this.running) { this.start(); return 0; }
+          if (!this.running) return 0;
+          this.update();
+          const delta = super.getDelta();
+          this.oldTime = performance.now();
+          this.elapsedTime += delta;
+          return delta;
+        }
+      })(),
       pointer,
       mouse: pointer,
       frameloop: 'always',
